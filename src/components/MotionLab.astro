---
import { motion } from '../data/site';
import { url } from '../lib/url';

const isDev = import.meta.env.DEV;
// On the live site only tiles with a real video are shown.
const items = isDev ? motion : motion.filter((m) => m.video);
---

{
  items.length > 0 && (
    <section id="lab" class="lab">
      <div class="container lab__inner">
        <div class="lab__head reveal">
          <div class="lab__title">
            <p class="eyebrow lab__eyebrow">Motion lab</p>
            <h2 class="h2">
              Interfaces that <span class="accent-word">move</span> with intent
            </h2>
          </div>
        </div>
        <div class="lab__grid" role="list">
          {items.map((m) => (
            <figure class="tile reveal" role="listitem">
              <div class="tile__media">
                {m.video ? (
                  <video src={url(m.video)} poster={m.poster && url(m.poster)} autoplay muted loop playsinline preload="metadata" aria-label={m.title} />
                ) : (
                  <div class="tile__placeholder">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10" />
                      <path d="M10 8.5l5.5 3.5-5.5 3.5z" />
                    </svg>
                    <span>Add a loop in src/data/site.ts</span>
                  </div>
                )}
              </div>
              <figcaption>
                <span class="tile__title">{m.title}</span>
                <span class="tile__kind">{m.kind}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="note reveal">
          <h3 class="note__title">
            A micro-interaction in <span class="accent-word">minutes</span>, not days
          </h3>
          <ol class="note__list">
            <li>
              <span class="note__idx">01</span>
              <div>
                <p class="note__head">Minutes to a working draft</p>
                <p class="note__text">New agentic tools turn an idea into a live micro-interaction in a matter of minutes.</p>
              </div>
            </li>
            <li>
              <span class="note__idx">02</span>
              <div>
                <p class="note__head">Yours to tweak</p>
                <p class="note__text">
                  Then adjust it to your taste, instead of spending days polishing every motion tween in Figma, Rive or
                  After Effects.
                </p>
              </div>
            </li>
            <li>
              <span class="note__idx">03</span>
              <div>
                <p class="note__head">Far easier to ship</p>
                <p class="note__text">Deploying got significantly simpler too.</p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>
  )
}

<script>
  // Pause loops for people who prefer reduced motion.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.lab video').forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
      v.controls = true;
    });
  }
</script>

<style>
  .lab {
    margin-top: clamp(96px, 12vw, 144px);
    border-block: 1px solid var(--night-edge);
    background: var(--night);
    color: var(--night-fg);
  }
  .lab__inner {
    padding-block: clamp(56px, 8vw, 96px);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .lab__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
  }
  .lab__title {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .lab__eyebrow {
    color: var(--night-muted);
  }
  .note {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 32px clamp(32px, 6vw, 96px);
    padding: clamp(28px, 4vw, 56px);
    border: 1px solid var(--night-line);
    border-radius: 20px;
    background: linear-gradient(135deg, var(--night-2), var(--night) 70%);
  }
  .note__title {
    align-self: start;
    max-width: 14ch;
    font-size: clamp(30px, 3.6vw, 48px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .note__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .note__list li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 16px;
    padding-block: 22px;
    border-top: 1px solid var(--night-line);
  }
  .note__list li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .note__list li:last-child {
    padding-bottom: 0;
  }
  .note__idx {
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.9;
    color: var(--accent);
  }
  .note__head {
    font-size: 18px;
    font-weight: 500;
  }
  .note__text {
    margin-top: 6px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--night-text);
  }
  .lab__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .tile__media {
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    background: var(--night-2);
  }
  .tile__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile__placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 16px;
    text-align: center;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--night-muted);
  }
  .tile__placeholder svg {
    color: var(--accent);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tile__title {
    font-size: 16px;
    font-weight: 500;
  }
  .tile__kind {
    font-size: 14px;
    color: var(--night-muted);
  }
  @media (max-width: 1023px) {
    .lab__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .note {
      grid-template-columns: minmax(0, 1fr);
    }
    .note__title {
      max-width: 20ch;
    }
  }
  @media (max-width: 640px) {
    .lab__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .lab__grid::-webkit-scrollbar {
      display: none;
    }
    .tile {
      flex: 0 0 72%;
      scroll-snap-align: start;
    }
  }
</style>
