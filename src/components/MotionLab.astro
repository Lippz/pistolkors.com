---
import { motion } from '../data/site';
import { url } from '../lib/url';

const isDev = import.meta.env.DEV;
// On the live site only tiles with a real video are shown.
const items = isDev ? motion : motion.filter((m) => m.video);
---

{
  items.length > 0 && (
    <section id="lab" class="lab">
      <div class="container lab__inner">
        <div class="lab__head reveal">
          <div class="lab__title">
            <p class="eyebrow lab__eyebrow">Motion lab</p>
            <h2 class="h2">
              <span class="bar-left"><b>Motion</b></span> with intent, not decoration
            </h2>
          </div>
        </div>
        <div class="lab__grid" role="list" data-lightbox-group>
          {items.map((m) => (
            <figure class="tile reveal" role="listitem">
              <div class="tile__media">
                {m.video ? (
                  <video src={url(m.video)} poster={m.poster && url(m.poster)} muted loop playsinline preload="metadata" aria-label={m.title} data-label={m.title} />
                ) : (
                  <div class="tile__placeholder">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10" />
                      <path d="M10 8.5l5.5 3.5-5.5 3.5z" />
                    </svg>
                    <span>Add a loop in src/data/site.ts</span>
                  </div>
                )}
              </div>
              <figcaption>
                <span class="tile__title">{m.title}</span>
                <span class="tile__kind">{m.kind}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <div class="lab__bar" role="group" aria-label="Browse the loops">
          <button type="button" class="lab__btn" data-dir="-1" aria-label="Previous loop">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
          </button>
          <span class="lab__count" aria-live="polite"></span>
          <button type="button" class="lab__btn" data-dir="1" aria-label="Next loop">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
          </button>
        </div>
      </div>
    </section>
  )
}

<script>
  // Loops stay on their poster until asked for. With a mouse a tile plays while it is hovered
  // (or has keyboard focus); on touch screens the tile that is most in view plays, one at a time.
  // People who prefer reduced motion get the poster only: the full-screen viewer has controls.
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.lab video')];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const hoverable = window.matchMedia('(hover: hover) and (pointer: fine)');
  const play = (v: HTMLVideoElement) => !reduced.matches && v.play().catch(() => {});
  const viewerOpen = () => !!document.querySelector('dialog.lb[open]');

  if (hoverable.matches) {
    for (const v of videos) {
      const start = () => !viewerOpen() && play(v);
      v.addEventListener('pointerenter', start);
      v.addEventListener('pointerleave', () => v.pause());
      v.addEventListener('focus', start);
      v.addEventListener('blur', () => v.pause());
    }
  } else if ('IntersectionObserver' in window) {
    // Intersection is measured through the scrolling row too, so on a phone the tile in the
    // middle of the carousel is the most visible one: it plays, and the next one starts as the
    // row is swiped.
    const ratio = new Map<HTMLVideoElement, number>();
    const pick = () => {
      if (viewerOpen()) return;
      let best: HTMLVideoElement | null = null;
      let top = 0.5;
      for (const [v, r] of ratio) if (r > top) [best, top] = [v, r];
      for (const v of videos) {
        if (v === best) play(v);
        else v.pause();
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) ratio.set(e.target as HTMLVideoElement, e.intersectionRatio);
        pick();
      },
      { threshold: [0, 0.25, 0.5, 0.75, 1] },
    );
    videos.forEach((v) => io.observe(v));
    // The viewer pauses the tiles behind it; pick again once it is closed.
    document.addEventListener('close', (e) => (e.target as Element).classList?.contains('lb') && pick(), true);
  }

  // The tiles form a scrollable row (scroll-snap) with arrows under it. On desktop two whole
  // tiles show, the active one is the first of them and the arrows move the row a tile at a time. On phones the centred tile is the active one; a tap on a neighbour brings it to the
  // centre, a tap on the active tile opens the full-screen viewer.
  const track = document.querySelector<HTMLElement>('.lab__grid');
  const slides = [...document.querySelectorAll<HTMLElement>('.lab .tile')];
  const prev = document.querySelector<HTMLButtonElement>('.lab__btn[data-dir="-1"]');
  const next = document.querySelector<HTMLButtonElement>('.lab__btn[data-dir="1"]');
  const count = document.querySelector<HTMLElement>('.lab__count');
  const phone = window.matchMedia('(max-width: 640px)');

  if (track && prev && next && count && slides.length > 1) {
    let active = 0;

    /** Where a tile sits when it is the active one: centred on phones, at the row's start on desktop. */
    const anchor = (s: HTMLElement) =>
      phone.matches
        ? s.offsetLeft + s.offsetWidth / 2 - track.clientWidth / 2
        : s.offsetLeft - parseFloat(getComputedStyle(track).paddingLeft);

    const goTo = (i: number, smooth = true) => {
      const s = slides[Math.max(0, Math.min(slides.length - 1, i))];
      track.scrollTo({ left: anchor(s), behavior: smooth && !reduced.matches ? 'smooth' : 'auto' });
    };

    const atEnd = () => track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;

    /** The tile whose place is nearest the scroll position. On phones the first and last win at the
        ends of the row; on desktop the last tiles share the end, so it stays the first one in view. */
    const nearest = () => {
      if (track.scrollLeft <= 2) return 0;
      if (phone.matches && atEnd()) return slides.length - 1;
      let best = 0;
      let dist = Infinity;
      slides.forEach((s, i) => {
        const d = Math.abs(anchor(s) - track.scrollLeft);
        if (d < dist) [best, dist] = [i, d];
      });
      return best;
    };

    const update = () => {
      active = nearest();
      slides.forEach((s, i) => s.classList.toggle('is-active', phone.matches && i === active));
      count.textContent = `${active + 1} / ${slides.length}`;
      prev.disabled = active === 0;
      next.disabled = active === slides.length - 1 || atEnd();
    };

    let frame = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    new ResizeObserver(update).observe(track);
    prev.addEventListener('click', () => goTo(active - 1));
    next.addEventListener('click', () => goTo(active + 1));
    slides.forEach((s, i) =>
      s.addEventListener(
        'click',
        (e) => {
          if (!phone.matches || i === active) return;
          e.stopPropagation();
          goTo(i);
        },
        true,
      ),
    );
    update();
  }
</script>

<style>
  .lab {
    margin-top: clamp(96px, 12vw, 144px);
    border-block: 1px solid var(--night-edge);
    background: var(--night);
    color: var(--night-fg);
  }
  .lab__inner {
    padding-block: clamp(56px, 8vw, 96px);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .lab__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
  }
  .lab__title {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .lab__eyebrow {
    color: var(--night-muted);
  }
  /* A scrollable row at every width. Desktop: two whole tiles across the column, snapping to its
     start, and the row runs on to the right edge of the window, so the next tiles show there; on
     the left it stops at the column, so no cut tile shows on that side. The right padding equals
     the run-on, so tile sizes still come from the column and the last tile can reach its start. */
  .lab__grid {
    --run-on: calc((100vw - 100%) / 2);
    position: relative;
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    margin-right: calc(-1 * var(--run-on));
    padding-right: var(--run-on);
    scrollbar-width: none;
  }
  .lab__grid::-webkit-scrollbar {
    display: none;
  }
  .tile {
    flex: 0 0 calc((100% - 16px) / 2);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .tile__media {
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: var(--night-2);
  }
  .tile__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile__placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 16px;
    text-align: center;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--night-muted);
  }
  .tile__placeholder svg {
    color: var(--accent);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tile__title {
    font-size: 16px;
    font-weight: 500;
  }
  .tile__kind {
    font-size: 14px;
    color: var(--night-muted);
  }
  .lab__bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    /* Closer to the row than the section's usual gap. */
    margin-top: -24px;
  }
  .lab__btn {
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgb(255 255 255 / 0.1);
    color: var(--night-fg);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .lab__btn:hover:not(:disabled) {
    background: rgb(255 255 255 / 0.2);
  }
  .lab__btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .lab__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .lab__count {
    min-width: 56px;
    text-align: center;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--night-muted);
    font-variant-numeric: tabular-nums;
  }
  /* Phones: tiles snap to the centre, so the first one sits at the column's left edge (the row
     cannot scroll further) and the next one peeks in from the right. */
  @media (max-width: 640px) {
    .lab__grid {
      gap: 12px;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }
    .tile {
      flex: 0 0 min(calc(100% - 56px), 320px);
      scroll-snap-align: center;
    }
    .tile__media {
      transition: filter 0.3s ease;
    }
    .tile:not(.is-active) .tile__media {
      filter: brightness(0.7);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile__media,
    .lab__btn {
      transition: none;
    }
  }
</style>
