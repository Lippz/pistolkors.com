---
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';

interface Props {
  /** Compact footer for case pages. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer id="contact" class:list={['footer', { 'footer--compact': compact }]}>
  <div class="container footer__inner">
    {
      compact ? (
        <div class="footer__cta-row">
          <p class="footer__cta-small">Got a complex product? Let’s talk.</p>
          <div class="footer__email-group">
            <a class="footer__email" href={`mailto:${site.email}`}>{site.email}</a>
            <button type="button" class="footer__copy" data-copy={site.email} hidden>Copy</button>
          </div>
        </div>
      ) : (
        <div class="footer__main">
          <p class="eyebrow footer__eyebrow">Contact</p>
          <h2 class="h-hero">
            Got a complex product? Let’s make it <span class="accent-word">clear.</span>
          </h2>
          <div class="footer__actions">
            <div class="footer__email-group">
            <a class="footer__email" href={`mailto:${site.email}`}>{site.email}</a>
            <button type="button" class="footer__copy" data-copy={site.email} hidden>Copy</button>
          </div>
            <div class="footer__links">
              {site.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener">
                  {l.label} ↗
                </a>
              ))}
              <a href={site.cv} target="_blank">
                Resume ↓
              </a>
            </div>
          </div>
        </div>
      )
    }

    {!compact && <Wordmark class="footer__wordmark" />}

    <div class="footer__bottom">
      <span>
        © <span data-year>{year}</span> {site.name}<span class="footer__clock" data-clock hidden> · <time></time> in Poznań, PL</span>
      </span>
      <div class="theme-switch" role="group" aria-label="Colour theme" hidden>
        <button type="button" data-theme-choice="auto" aria-pressed="true">Auto</button>
        <button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
        <button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
      </div>
      {
        compact ? (
          <div class="footer__links">
            {site.links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener">
                {l.label} ↗
              </a>
            ))}
            <a href={site.cv} target="_blank">
              Resume ↓
            </a>
          </div>
        ) : (
          <span>Remote worldwide</span>
        )
      }
    </div>
    <span class="footer__status" role="status" data-copy-status></span>
  </div>
</footer>

<script>
  import { getChoice, setChoice, onThemeChange, type ThemeChoice } from '../lib/theme';

  // Theme switch: Auto (follow the system) · Light · Dark.
  const themeSwitch = document.querySelector<HTMLElement>('.theme-switch');
  if (themeSwitch) {
    const buttons = [...themeSwitch.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')];
    buttons.forEach((b) => b.addEventListener('click', () => setChoice(b.dataset.themeChoice as ThemeChoice)));
    onThemeChange(() => {
      const choice = getChoice();
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeChoice === choice)));
    });
    themeSwitch.hidden = false;
  }

  // Copy the email address. The button only appears where the Clipboard API works.
  const status = document.querySelector('[data-copy-status]');
  if (navigator.clipboard && window.isSecureContext) {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.hidden = false;
      let timer: number | undefined;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        } catch {
          return;
        }
        btn.textContent = 'Copied';
        btn.classList.add('is-done');
        if (status) status.textContent = 'Email address copied';
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('is-done');
          if (status) status.textContent = '';
        }, 2000);
      });
    });
  }

  // Local time in Poznań, so remote teams see the time zone at a glance.
  const clocks = document.querySelectorAll<HTMLElement>('[data-clock]');
  if (clocks.length) {
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit' });
    const tick = () =>
      clocks.forEach((c) => {
        const t = c.querySelector('time');
        if (t) t.textContent = fmt.format(new Date());
        c.hidden = false;
      });
    tick();
    window.setInterval(tick, 30_000);
  }
</script>

<style>
  .footer {
    margin-top: clamp(96px, 12vw, 144px);
    border-top: 1px solid var(--night-edge);
    background: var(--night);
    color: var(--night-fg);
  }
  .footer a {
    color: var(--night-fg);
  }
  .footer a:hover {
    color: var(--accent);
  }
  .footer__inner {
    padding-top: clamp(64px, 9vw, 120px);
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 7vw, 80px);
  }
  /* The full contact block fills the screen below the sticky header once you
     reach it; the wordmark and bottom row sit at the bottom. `svh` so mobile
     browser bars don't make it jump. */
  .footer:not(.footer--compact) .footer__inner {
    min-height: calc(100svh - var(--header-h));
  }
  .footer:not(.footer--compact) :global(.footer__wordmark) {
    margin-top: auto;
  }
  .footer--compact .footer__inner {
    padding-top: 64px;
    gap: 48px;
  }
  .footer__main {
    display: flex;
    flex-direction: column;
  }
  .footer__main :global(.h-hero) {
    margin-top: 20px;
  }
  .footer__actions {
    margin-top: clamp(32px, 4vw, 48px);
  }
  .footer__eyebrow {
    color: var(--night-muted);
  }
  .footer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px 40px;
  }
  .footer__email-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .footer__copy {
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--night-line);
    border-radius: 999px;
    background: transparent;
    color: var(--night-fg);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
    /* Only the border animates; the Copied fill swaps instantly so text and
       fill never pass through the same colour. */
    transition: border-color 0.2s ease;
  }
  .footer__copy:hover {
    border-color: var(--night-fg);
  }
  .footer__copy.is-done {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }
  .footer__copy[hidden] {
    display: none;
  }
  .theme-switch {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--night-line);
    border-radius: 999px;
  }
  .theme-switch[hidden] {
    display: none;
  }
  .theme-switch button {
    min-height: 38px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--night-muted);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .theme-switch button:hover {
    color: var(--night-fg);
  }
  .theme-switch button[aria-pressed='true'] {
    background: var(--night-fg);
    color: var(--night);
    transition: none;
  }
  .footer__clock time {
    font-variant-numeric: tabular-nums;
  }
  .footer__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .footer__email {
    font-size: clamp(1.25rem, 0.9rem + 1.4vw, 2rem);
    letter-spacing: -0.02em;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 4px;
    overflow-wrap: anywhere;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    font-size: 16px;
  }
  .footer__links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .footer__cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .footer__cta-small {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
    letter-spacing: -0.035em;
    font-weight: 500;
  }
  :global(.footer__wordmark) {
    font-size: clamp(20px, 7.7vw, 112px);
    letter-spacing: 0.2em;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--night-line);
    padding-top: 24px;
    font-size: 14px;
    color: var(--night-muted);
  }
</style>
