---
import Wordmark from './Wordmark.astro';
import { site, motion } from '../data/site';
import { url } from '../lib/url';

interface Props {
  current?: 'work';
  /** Show a reading-progress bar along the bottom edge. */
  progress?: boolean;
}
const { current, progress = false } = Astro.props;
// Mirrors MotionLab.astro: the section is hidden live until it has a video.
const showLab = import.meta.env.DEV || motion.some((m) => m.video);

const nav = [
  { label: 'Work', href: url('/#work'), key: 'work' },
  ...(showLab ? [{ label: 'Motion lab', href: url('/#lab'), key: 'lab' }] : []),
  { label: 'About', href: url('/#about'), key: 'about' },
  { label: 'Resume', href: site.cv, key: 'cv' },
];
---

<header class="header">
  <div class="container header__inner">
    <a href={url('/')} class="header__brand" aria-label="Pylyp Pistolkors — home">
      <Wordmark intro />
    </a>

    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path class="l1" d="M4 8h16"></path>
        <path class="l2" d="M4 16h16"></path>
      </svg>
    </button>

    <nav id="site-nav" class="header__nav" aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={current === item.key ? 'page' : undefined} target={item.key === 'cv' ? '_blank' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={url('/#contact')} class="btn btn--ink">Get in touch</a>
    </nav>

    <button class="theme-toggle" type="button" aria-label="Switch to dark theme">
      <svg class="theme-toggle__moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
      </svg>
      <svg class="theme-toggle__sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
      </svg>
    </button>
  </div>
  {progress && <div class="header__progress" aria-hidden="true"></div>}
</header>

<script>
  import { getTheme, setChoice, onThemeChange } from '../lib/theme';

  // Theme button: flips between light and dark; "Auto" lives in the footer.
  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => setChoice(getTheme() === 'dark' ? 'light' : 'dark'));
    onThemeChange(() => {
      themeBtn.setAttribute('aria-label', getTheme() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    });
  }

  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const nav = document.getElementById('site-nav');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('menu-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    /* Stays put while the page underneath transitions. */
    view-transition-name: site-header;
  }
  .header__progress {
    display: none;
  }
  /* Reading progress, driven by page scroll. No JS; hidden where unsupported. */
  @supports (animation-timeline: scroll()) {
    .header__progress {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 2px;
      background: var(--accent);
      transform-origin: 0 50%;
      animation: read-progress linear both;
    }
    /* Kept in a separate, more specific rule: the CSS minifier otherwise folds
       the timeline into the \`animation\` shorthand, which browsers reject. */
    .header .header__progress {
      animation-timeline: scroll(root);
    }
  }
  @keyframes read-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  /* Standard property only: with both, the CSS minifier kept just the
     -webkit- one, which Chrome ignores. */
  @supports (backdrop-filter: blur(1px)) {
    .header {
      background: color-mix(in srgb, var(--paper) 72%, transparent);
      backdrop-filter: saturate(1.8) blur(20px);
    }
  }
  .header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .header__brand {
    display: flex;
    align-items: center;
    font-size: 22px;
    line-height: 1;
  }
  .header__brand:hover {
    color: var(--ink);
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: 36px;
    margin-left: auto;
    font-size: 15px;
  }
  .theme-toggle {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    margin-left: -8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .theme-toggle:hover {
    background: var(--surface);
  }
  /* Show the moon in the light theme (click for dark) and the sun in the dark one. */
  .theme-toggle__sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle__sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme-toggle__moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle__sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle__moon {
      display: none;
    }
  }
  .header__nav a[aria-current='page'] {
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }
  .header__toggle {
    display: none;
  }

  @media (max-width: 860px) {
    .header__inner {
      gap: 4px;
    }
    .header__brand {
      font-size: 17px;
    }
    /* Theme button stays in the bar, just before the menu button. */
    .theme-toggle {
      margin-left: auto;
    }
    .header__toggle {
      order: 3;
    }
    .header__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }
    .header__toggle path {
      transition: transform 0.25s ease;
      transform-origin: center;
    }
    .header__toggle[aria-expanded='true'] .l1 {
      transform: translateY(4px) rotate(45deg);
    }
    .header__toggle[aria-expanded='true'] .l2 {
      transform: translateY(-4px) rotate(-45deg);
    }
    .header__nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      height: calc(100dvh - var(--header-h));
      padding: 32px var(--gutter);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--paper);
      font-size: 28px;
      letter-spacing: -0.03em;
      font-weight: 500;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0s linear 0.2s;
    }
    .header__nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }
    .header__nav a {
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
    }
    .header__nav a[aria-current='page'] {
      border-bottom: 1px solid var(--line);
      color: var(--accent-ink);
    }
    .header__nav .btn {
      margin-top: 32px;
      min-height: 56px;
      border: 0;
      font-size: 17px;
      letter-spacing: 0;
    }
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
