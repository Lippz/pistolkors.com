---
import Wordmark from './Wordmark.astro';
import { motion, testimonials } from '../data/site';
import { url } from '../lib/url';

interface Props {
  current?: 'work';
  /** Show a reading-progress bar along the bottom edge. */
  progress?: boolean;
}
const { current, progress = false } = Astro.props;
// Mirrors MotionLab.astro: the section is hidden live until it has a video.
const showLab = import.meta.env.DEV || motion.some((m) => m.video);
// Mirrors Testimonials.astro: the section is hidden live until it has a real quote.
const showWords = import.meta.env.DEV || testimonials.some((t) => !t.placeholder);

const nav = [
  { label: 'Recent works', href: url('/#work'), key: 'work' },
  ...(showWords ? [{ label: 'People', href: url('/#words'), key: 'words' }] : []),
  ...(showLab ? [{ label: 'Interactions', href: url('/#lab'), key: 'lab' }] : []),
  { label: 'How I work', href: url('/#how'), key: 'how' },
  { label: 'AI pipeline', href: url('/#ai'), key: 'ai' },
  { label: 'About', href: url('/#about'), key: 'about' },
];
---

<header class="header">
  <div class="container header__inner">
    <a href={url('/')} class="header__brand" aria-label="Pylyp Pistolkors — home">
      <Wordmark intro outlined />
    </a>

    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path class="l1" d="M4 8h16"></path>
        <path class="l2" d="M4 16h16"></path>
      </svg>
    </button>

    <nav id="site-nav" class="header__nav" aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={url('/#contact')} class="btn btn--ink">Get in touch</a>
      <span class="header__bar" aria-hidden="true"></span>
    </nav>

    <button class="theme-toggle" type="button" aria-label="Switch to dark theme">
      <svg class="theme-toggle__moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
      </svg>
      <svg class="theme-toggle__sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
      </svg>
    </button>
  </div>
  {progress && <div class="header__progress" aria-hidden="true"></div>}
</header>

<script>
  import { getTheme, setChoice, onThemeChange } from '../lib/theme';

  // Theme button: flips between light and dark; "Auto" lives in the footer.
  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => setChoice(getTheme() === 'dark' ? 'light' : 'dark'));
    onThemeChange(() => {
      themeBtn.setAttribute('aria-label', getTheme() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
    });
  }

  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const nav = document.getElementById('site-nav');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('menu-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  // The logo on the home page scrolls back to the top, like the menu items scroll to their
  // sections, instead of reloading the page. Elsewhere it is a plain link home.
  const brand = document.querySelector<HTMLAnchorElement>('.header__brand');
  brand?.addEventListener('click', (e) => {
    if (brand.pathname !== location.pathname || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    setOpen(false);
    if (location.hash) history.pushState(null, '', brand.pathname + location.search);
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: calm ? 'instant' : 'smooth' });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });

  // One underline that travels between menu items. Its edges move separately: the leading
  // edge sets off first and the trailing one follows, so the bar stretches on the way.
  const bar = nav?.querySelector<HTMLElement>('.header__bar');
  let barOn: HTMLAnchorElement | undefined;
  const placeBar = (a: HTMLAnchorElement | undefined, lead: 'left' | 'right' | 'none') => {
    if (!bar || !nav) return;
    bar.dataset.lead = lead;
    if (!a) return;
    const n = nav.getBoundingClientRect();
    const r = a.getBoundingClientRect();
    bar.style.top = `${r.bottom - n.top + 2}px`;
    bar.style.left = `${r.left - n.left}px`;
    bar.style.right = `${n.right - r.right}px`;
  };
  const moveBar = (a: HTMLAnchorElement | undefined) => {
    if (!bar || !nav || a === barOn) return;
    const from = barOn;
    barOn = a;
    if (a && !from) {
      // Appears: starts as a dot on the item's left edge and grows to the right.
      placeBar(a, 'none');
      bar.style.right = `${nav.getBoundingClientRect().right - a.getBoundingClientRect().left}px`;
      bar.getBoundingClientRect();
      bar.classList.add('is-on');
      placeBar(a, 'right');
    } else if (a && from) {
      const right = a.getBoundingClientRect().left > from.getBoundingClientRect().left;
      placeBar(a, right ? 'right' : 'left');
    } else if (from) {
      // Leaves: shrinks into the edge it was heading for (left above the first section).
      const n = nav.getBoundingClientRect();
      const r = from.getBoundingClientRect();
      const toLeft = from === spyLinks[0]?.a;
      bar.dataset.lead = toLeft ? 'left' : 'right';
      if (toLeft) bar.style.right = `${n.right - r.left}px`;
      else bar.style.left = `${r.right - n.left}px`;
      bar.classList.remove('is-on');
    }
  };
  // Re-measure without animating when the layout shifts (resize, late web fonts).
  const snapBar = () => {
    if (!bar || !barOn) return;
    placeBar(barOn, 'none');
  };
  window.addEventListener('resize', snapBar);
  document.fonts?.ready.then(snapBar);
  const pageLink = nav?.querySelector<HTMLAnchorElement>('a[aria-current="page"]');
  if (pageLink) {
    barOn = pageLink;
    bar?.classList.add('is-on');
    placeBar(pageLink, 'none');
  }

  // Scroll spy: underline the menu item whose section sits under the header.
  const spyLinks = [...(nav?.querySelectorAll<HTMLAnchorElement>('a[href*="#"]:not(.btn)') ?? [])]
    .map((a) => ({ a, el: document.getElementById(a.hash.slice(1)) }))
    .filter((l): l is { a: HTMLAnchorElement; el: HTMLElement } => !!l.el && l.a.pathname === location.pathname);
  if (spyLinks.length) {
    let ticking = false;
    // A click picks its item at once; the spy holds off until the page arrives there (or
    // stops somewhere else), so the bar doesn't trail through every section on the way.
    let picked: HTMLAnchorElement | undefined;
    let settle = 0;
    const holdUntilStill = () => {
      clearTimeout(settle);
      settle = window.setTimeout(() => {
        picked = undefined;
        update();
      }, 400);
    };
    const mark = (active: HTMLAnchorElement | undefined) => {
      spyLinks.forEach(({ a }) => a.classList.toggle('is-active', a === active));
      moveBar(active);
    };
    spyLinks.forEach(({ a }) =>
      a.addEventListener('click', () => {
        picked = a;
        mark(a);
        holdUntilStill();
      }),
    );
    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.35;
      // The last section whose top has passed the line stays active through the gap before
      // the next one; nothing is active above the first section or below the last.
      let active: HTMLAnchorElement | undefined;
      for (const { a, el } of spyLinks) if (el.getBoundingClientRect().top <= line) active = a;
      if (spyLinks[spyLinks.length - 1].el.getBoundingClientRect().bottom <= line) active = undefined;
      if (picked && active !== picked) return;
      picked = undefined;
      mark(active);
    };
    const onScroll = () => {
      if (picked) holdUntilStill();
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .header__progress {
    display: none;
  }
  /* Reading progress, driven by page scroll. No JS; hidden where unsupported. */
  @supports (animation-timeline: scroll()) {
    .header__progress {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 2px;
      background: var(--accent);
      transform-origin: 0 50%;
      animation: read-progress linear both;
    }
    /* Kept in a separate, more specific rule: the CSS minifier otherwise folds
       the timeline into the \`animation\` shorthand, which browsers reject. */
    .header .header__progress {
      animation-timeline: scroll(root);
    }
  }
  @keyframes read-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  /* Standard property only: with both, the CSS minifier kept just the
     -webkit- one, which Chrome ignores. */
  @supports (backdrop-filter: blur(1px)) {
    .header {
      background: color-mix(in srgb, var(--paper) 72%, transparent);
      backdrop-filter: saturate(1.8) blur(20px);
    }
  }
  .header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .header__brand {
    display: flex;
    align-items: center;
    font-size: 22px;
    line-height: 1;
  }
  /* A slightly larger shield here than in the footer lockup. */
  .header__brand :global(.wordmark .wordmark__mark) {
    width: 1.5em;
    height: 1.5em;
  }
  .header__brand:hover {
    color: var(--ink);
  }
  .header__nav {
    display: flex;
    align-items: center;
    gap: 36px;
    margin-left: auto;
    font-size: 15px;
  }
  .theme-toggle {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    margin-left: -8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .theme-toggle:hover {
    background: var(--surface);
  }
  /* Show the moon in the light theme (click for dark) and the sun in the dark one. */
  .theme-toggle__sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle__sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme-toggle__moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle__sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle__moon {
      display: none;
    }
  }
  /* The travelling underline (see the script): edges animate on their own, the leading
     one first. Text never shifts, since the bar is absolutely positioned. */
  .header__nav {
    position: relative;
  }
  .header__bar {
    --move: 0.32s cubic-bezier(0.65, 0, 0.25, 1);
    --lag: 0.07s;
    position: absolute;
    left: 0;
    right: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    opacity: 0;
    pointer-events: none;
    transition:
      left var(--move),
      right var(--move),
      opacity 0.2s ease;
  }
  .header__bar.is-on {
    opacity: 1;
  }
  .header__bar[data-lead='right'] {
    transition:
      left var(--move) var(--lag),
      right var(--move),
      opacity 0.2s ease;
  }
  .header__bar[data-lead='left'] {
    transition:
      left var(--move),
      right var(--move) var(--lag),
      opacity 0.2s ease;
  }
  .header__bar[data-lead='none'] {
    transition: none;
  }
  /* Leaving: shrink first, then fade. */
  .header__bar:not(.is-on) {
    transition-property: left, right, opacity;
    transition-delay: 0s, 0s, 0.18s;
  }
  @media (prefers-reduced-motion: reduce) {
    .header__bar {
      transition: opacity 0.2s ease !important;
    }
  }
  .header__toggle {
    display: none;
  }

  /* Six menu items: tighten the spacing before the bar runs out of room. */
  @media (max-width: 1280px) {
    .header__nav {
      gap: 24px;
    }
  }

  @media (max-width: 1100px) {
    .header__inner {
      gap: 4px;
    }
    .header__brand {
      font-size: 17px;
    }
    /* Theme button stays in the bar, just before the menu button. */
    .theme-toggle {
      margin-left: auto;
    }
    .header__toggle {
      order: 3;
    }
    .header__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }
    .header__toggle path {
      transition: transform 0.25s ease;
      transform-origin: center;
    }
    .header__toggle[aria-expanded='true'] .l1 {
      transform: translateY(4px) rotate(45deg);
    }
    .header__toggle[aria-expanded='true'] .l2 {
      transform: translateY(-4px) rotate(-45deg);
    }
    .header__nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      height: calc(100dvh - var(--header-h));
      padding: 32px var(--gutter);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--paper);
      font-size: 28px;
      letter-spacing: -0.03em;
      font-weight: 500;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.2s ease,
        transform 0.2s ease,
        visibility 0s linear 0.2s;
    }
    .header__nav.is-open {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 0.2s ease,
        transform 0.2s ease;
    }
    .header__nav a {
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
    }
    .header__bar {
      display: none;
    }
    .header__nav a[aria-current='page'],
    .header__nav a.is-active {
      border-bottom: 1px solid var(--line);
      color: var(--accent-ink);
    }
    .header__nav .btn {
      margin-top: 32px;
      min-height: 56px;
      border: 0;
      font-size: 17px;
      letter-spacing: 0;
    }
  }
  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
