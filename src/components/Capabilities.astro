---
/** "How I work": one card per discipline, with what it delivers. */
import { capabilities } from '../data/site';
---

<section id="how" class="how container">
  <div class="how__head reveal">
    <p class="eyebrow">How I work</p>
    <h2 class="h2">No guesses — research turned into <span class="bar-right"><b>behaviour</b></span></h2>
    <p class="lead">
      Discovery, product UI and motion in one pair of hands: I find out what people
      need, build the system around it and prototype the interactions in code, so engineers get working behaviour,
      not a description of it.
    </p>
  </div>

  <ol class="how__grid" role="list">
    {
      capabilities.map((c, i) => (
        <li class="cap reveal">
          <p class="eyebrow cap__idx">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="cap__title">{c.title}</h3>
          <p class="cap__text">{c.text}</p>

          <p class="eyebrow cap__label">Deliverables</p>
          <p class="cap__deliverables">{c.deliverables.join(' · ')}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .how {
    margin-top: clamp(96px, 12vw, 144px);
    scroll-margin-top: clamp(32px, 5vw, 56px);
  }
  .how__head {
    display: flex;
    flex-direction: column;
  }
  .how__head .h2 {
    margin-top: 16px;
    max-width: 18ch;
  }
  .how__head .lead {
    margin-top: 24px;
  }
  .how__grid {
    margin-top: clamp(40px, 5vw, 64px);
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 16px;
  }
  /* Subgrid: titles and lists line up across the three cards even when a title wraps. */
  .cap {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    align-content: start;
    padding: clamp(24px, 2.5vw, 32px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .cap__idx {
    color: var(--accent-ink);
  }
  .cap__title {
    margin-top: 16px;
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 500;
  }
  .cap__text {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  /* The deliverables sit under a small label, a clear step away from the text above. */
  .cap__label {
    margin-top: 32px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    font-size: 0.75rem;
  }
  .cap__deliverables {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-3);
  }

  @media (max-width: 1023px) {
    .how__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .cap {
      grid-row: auto;
      grid-template-rows: none;
    }
  }
</style>
