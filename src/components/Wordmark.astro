---
/** "PYLYP PISTOLK🛡RS" — the brand wordmark with the pistol shield standing in for the "o". */
import Shield from '../assets/brand/shield.svg';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['wordmark', className]}>
  <span>Pylyp Pistolk</span><Shield class="wordmark__o" aria-hidden="true" /><span class="sr-o">o</span><span>rs</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  /* The SVG component renders outside this component's style scope. */
  .wordmark :global(.wordmark__o) {
    flex-shrink: 0;
    width: 1em;
    height: 1em;
    margin-right: 0.22em;
    color: var(--accent);
  }
  .sr-o {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
