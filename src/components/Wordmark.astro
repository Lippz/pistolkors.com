---
/** Brand lockup: the pistol shield followed by "PYLYP PISTOLKORS". */
import Shield from '../assets/brand/shield.svg';

interface Props {
  class?: string;
  /** Play the shield's entrance on the first page of a visit. */
  intro?: boolean;
}
const { class: className, intro = false } = Astro.props;
---

<span class:list={['wordmark', { 'wordmark--intro': intro }, className]}>
  <Shield class="wordmark__mark" aria-hidden="true" /><span class="wordmark__text">Pylyp Pistolkors</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--display);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  .wordmark__text {
    letter-spacing: 0.22em;
    /* Cancel the tracking after the last letter so the lockup ends flush. */
    margin-right: -0.22em;
  }
  /* The SVG component renders outside this component's style scope. */
  .wordmark :global(.wordmark__mark) {
    flex-shrink: 0;
    width: 1.3em;
    height: 1.3em;
    color: var(--accent);
    /* The shield touches the viewBox edges; don't clip its antialiased rim. */
    overflow: visible;
    transform-origin: 50% 70%;
    transition: filter 0.3s ease;
  }
  /* Hover or keyboard focus on the logo link: the shield glows, nothing moves. */
  .wordmark:hover :global(.wordmark__mark),
  :global(a:focus-visible) .wordmark :global(.wordmark__mark) {
    filter: brightness(1.08) drop-shadow(0 0 0.28em color-mix(in srgb, var(--accent) 55%, transparent));
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrance: the shield drops in with a small overshoot, once per tab. */
    :global(html:not([data-intro-seen])) .wordmark--intro :global(.wordmark__mark) {
      animation: shield-in 0.7s cubic-bezier(0.2, 0.8, 0.25, 1.15) 0.15s both;
    }
  }

  @keyframes shield-in {
    from {
      opacity: 0;
      transform: translateY(-35%) rotate(-22deg) scale(0.6);
    }
    60% {
      opacity: 1;
      transform: translateY(4%) rotate(5deg) scale(1.06);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
