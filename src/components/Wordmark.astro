---
/** Brand lockup: the pistol shield followed by "PYLYP PISTOLKORS". */
import Shield from '../assets/brand/shield.svg';

interface Props {
  class?: string;
  /** Play the shield's entrance on the first page of a visit. */
  intro?: boolean;
}
const { class: className, intro = false } = Astro.props;
---

<span class:list={['wordmark', { 'wordmark--intro': intro }, className]}>
  <span class="wordmark__mark-zone"><Shield class="wordmark__mark" aria-hidden="true" /></span><span class="wordmark__text">Pylyp Pistolkors</span>
</span>

<script>
  // 3D tilt: the shield leans towards the cursor while it moves over the shield.
  // Events go to a wrapper that never transforms, so the tilted shape can't
  // slip out from under the pointer at the edges.
  const MAX_DEG = 25;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const clamp = (n: number) => Math.max(-1, Math.min(1, n));

  document.querySelectorAll<HTMLElement>('.wordmark').forEach((wordmark) => {
    const mark = wordmark.querySelector<SVGSVGElement>('.wordmark__mark');
    const zone = wordmark.querySelector<HTMLElement>('.wordmark__mark-zone');
    if (!mark || !zone) return;
    let rect: DOMRect | null = null;
    let frame = 0;

    zone.addEventListener('pointerenter', () => {
      rect = zone.getBoundingClientRect();
    });
    zone.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch' || !finePointer.matches || reducedMotion.matches) return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = (rect ??= zone.getBoundingClientRect());
        // -1…1 across the shield: full tilt at its edges.
        const dx = clamp((e.clientX - (r.left + r.width / 2)) / (r.width / 2));
        const dy = clamp((e.clientY - (r.top + r.height / 2)) / (r.height / 2));
        mark.classList.add('is-tilting');
        // The edge nearest the cursor dips away, as if pressed.
        mark.style.setProperty('--tilt-y', `${(dx * MAX_DEG).toFixed(2)}deg`);
        mark.style.setProperty('--tilt-x', `${(-dy * MAX_DEG).toFixed(2)}deg`);
      });
    });
    zone.addEventListener('pointerleave', () => {
      cancelAnimationFrame(frame);
      rect = null;
      mark.classList.remove('is-tilting');
      mark.style.removeProperty('--tilt-x');
      mark.style.removeProperty('--tilt-y');
    });
  });
</script>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--display);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  .wordmark__text {
    letter-spacing: 0.22em;
    /* Cancel the tracking after the last letter so the lockup ends flush. */
    margin-right: -0.22em;
  }
  .wordmark__mark-zone {
    display: inline-flex;
    flex-shrink: 0;
  }
  /* The SVG component renders outside this component's style scope. */
  .wordmark :global(.wordmark__mark) {
    flex-shrink: 0;
    width: 1.3em;
    height: 1.3em;
    color: var(--accent);
    /* The shield touches the viewBox edges; don't clip its antialiased rim. */
    overflow: visible;
    transform: perspective(3em) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    /* Slow settle back to flat when the cursor leaves… */
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* …and a quick follow while it moves. */
  .wordmark :global(.wordmark__mark.is-tilting) {
    transition-duration: 0.12s;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrance: the shield drops in with a small overshoot, once per tab.
       `backwards` (not `both`) so the tilt transform takes over afterwards. */
    :global(html:not([data-intro-seen])) .wordmark--intro :global(.wordmark__mark) {
      animation: shield-in 0.7s cubic-bezier(0.2, 0.8, 0.25, 1.15) 0.15s backwards;
    }
  }

  @keyframes shield-in {
    from {
      opacity: 0;
      transform: translateY(-35%) rotate(-22deg) scale(0.6);
    }
    60% {
      opacity: 1;
      transform: translateY(4%) rotate(5deg) scale(1.06);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
