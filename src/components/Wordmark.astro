---
/** Brand lockup: the pistol shield followed by "PYLYP PISTOLKORS". */
import Shield from '../assets/brand/shield.svg';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['wordmark', className]}>
  <Shield class="wordmark__mark" aria-hidden="true" /><span class="wordmark__text">Pylyp Pistolkors</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--display);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
  .wordmark__text {
    letter-spacing: 0.22em;
    /* Cancel the tracking after the last letter so the lockup ends flush. */
    margin-right: -0.22em;
  }
  /* The SVG component renders outside this component's style scope. */
  .wordmark :global(.wordmark__mark) {
    flex-shrink: 0;
    width: 1.3em;
    height: 1.3em;
    color: var(--accent);
    /* The shield touches the viewBox edges; don't clip its antialiased rim. */
    overflow: visible;
  }
</style>
