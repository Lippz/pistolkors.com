---
/** Large home-page row: cover on one side, story on the other. */
import type { CollectionEntry } from 'astro:content';
import CaseCover from './CaseCover.astro';
import { url } from '../lib/url';

interface Props {
  entry: CollectionEntry<'cases'>;
  index: number;
  flip?: boolean;
}
const { entry, index, flip = false } = Astro.props;
const d = entry.data;
const href = url(`/work/${entry.id}/`);
const num = String(index).padStart(2, '0');
---

<article class:list={['feature reveal', { 'feature--flip': flip }]}>
  <a href={href} class="feature__media" tabindex="-1" aria-hidden="true">
    <CaseCover id={entry.id} cover={d.cover} hover={d.hover} sizes="(min-width: 1024px) 58vw, 100vw" eager={index === 1} class="feature__cover" />
  </a>
  <div class="feature__body">
    <div class="feature__top">
      <p class="eyebrow">{num} — {d.client} · {d.industry}</p>
      <h3 class="h3"><a href={href} class="feature__link">{d.title}</a></h3>
      <p class="feature__summary">{d.summary}</p>
      {d.tags.length > 0 && <div class="chips">{d.tags.map((t) => <span class="chip">{t}</span>)}</div>}
    </div>
    <div class="feature__meta">
      <dl>
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Timeline</dt><dd>{d.timeline}</dd></div>
        <div><dt>Year</dt><dd>{d.year}</dd></div>
      </dl>
      <span class="feature__cta" aria-hidden="true">Read case <span class="feature__arrow">→</span></span>
    </div>
  </div>
</article>

<style>
  .feature {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
  }
  .feature__media {
    grid-column: span 7;
  }
  .feature :global(.feature__cover) {
    aspect-ratio: 16 / 11;
  }
  .feature__body {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 8px 0;
  }
  .feature--flip .feature__media {
    order: 2;
  }
  .feature__top {
    display: flex;
    flex-direction: column;
  }
  /* Label hugs the title, title leads into the summary, tags trail a bit. */
  .feature__top :global(.h3) {
    margin-top: 12px;
  }
  .feature__summary {
    margin-top: 16px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  .feature__top .chips {
    margin-top: 24px;
  }
  .feature__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  dl {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    font-size: 14px;
  }
  dl div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  /* The title link stretches over the whole block, so the entire row is one
     click target (the media link and the CTA are decorative duplicates). */
  .feature__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .feature:has(.feature__link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 12px;
    border-radius: var(--radius);
  }
  .feature__link:focus-visible {
    outline: none;
  }
  .feature__cta {
    font-size: 15px;
    font-weight: 500;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .feature__arrow {
    display: inline-block;
    transition: transform 0.18s ease-out;
  }
  @media (hover: hover) {
    .feature:hover .feature__arrow,
    .feature:has(.feature__link:focus-visible) .feature__arrow {
      transform: translateX(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .feature__arrow {
      transition: none;
    }
  }
  @media (max-width: 1023px) {
    .feature {
      grid-template-columns: 1fr;
    }
    .feature__media,
    .feature__body {
      grid-column: auto;
    }
    .feature--flip .feature__media {
      order: 0;
    }
  }
</style>
