---
/**
 * A case cover in a rounded frame. While the surrounding link, card or row is
 * hovered or focused, the picture zooms in a touch inside the frame.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  cover: ImageMetadata;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { id, cover, sizes, eager = false, class: className } = Astro.props;
---

<div class:list={['cover frame', className]}>
  <Image src={cover} alt="" sizes={sizes} loading={eager ? 'eager' : 'lazy'} class="cover__img" />
</div>

<style>
  .cover :global(.cover__img) {
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (hover: hover) {
    :global(:is(a, article):is(:hover, :has(:focus-visible))) .cover :global(.cover__img) {
      transform: scale(1.04);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cover :global(.cover__img) {
      transition: none;
      transform: none !important;
    }
  }
</style>
