---
/**
 * A case cover in a rounded frame. It shares a view-transition name with the
 * cover on the case page, so the browser morphs one into the other. When the
 * case has a `hover` frame, it fades in while the surrounding link or card is
 * hovered or focused.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  cover: ImageMetadata;
  hover?: ImageMetadata;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { id, cover, hover, sizes, eager = false, class: className } = Astro.props;
---

<div class:list={['cover frame', className]} style={`view-transition-name: case-${id}`}>
  <Image src={cover} alt="" sizes={sizes} loading={eager ? 'eager' : 'lazy'} class="cover__img" />
  {hover && <Image src={hover} alt="" sizes={sizes} loading="lazy" class="cover__img cover__img--hover" />}
</div>

<style>
  .cover {
    position: relative;
    view-transition-class: case-cover;
  }
  .cover :global(.cover__img--hover) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition:
      opacity 0.45s ease,
      transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (hover: hover) {
    :global(:is(a, article):is(:hover, :focus-visible)) .cover :global(.cover__img--hover) {
      opacity: 1;
    }
  }
</style>
