---
/**
 * Image carousel: slides sit in a row on a native scroll-snap track, each about 80%
 * of the column wide, so the edge of the neighbouring slides peeks in on both sides
 * (the first one starts flush with the column's left edge). Swipe, trackpad,
 * ←/→ keys, the buttons below and a click on a peeking neighbour all move it; a
 * click on the centred slide opens the image viewer with just the carousel's images.
 * Add it in a case's Markdown as
 *
 *   <div class="carousel">
 *
 *   ![Alt text](path "Short label")
 *
 *   ![Alt text](path "Another label")
 *
 *   </div>
 *
 * The label is read by screen readers and shown as the caption in the viewer.
 * A screen much taller than the shortest one in the carousel is cut at the bottom to
 * the same proportions (with a soft fade); the viewer still opens the whole screen.
 * Without JavaScript the images simply follow each other.
 */
---

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  /** A slide counts as tall when its height-to-width ratio is this much above the shortest slide's. */
  const TALL = 1.2;
  const arrow = (d: string) =>
    `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"></path></svg>`;

  document.querySelectorAll<HTMLElement>('.carousel').forEach((root) => {
    const imgs = [...root.querySelectorAll<HTMLImageElement>('img')];
    const n = imgs.length;
    if (n < 2) return;

    // Small source images: don't stretch a slide beyond the narrowest image's own width.
    const naturalW = Math.min(...imgs.map((i) => Number(i.getAttribute('width')) || Infinity));
    if (Number.isFinite(naturalW)) root.style.setProperty('--slide-max', `${naturalW}px`);

    // Screens much taller than the shortest one are cut at the bottom to its proportions,
    // so the row keeps one height; the viewer still opens the whole screen.
    const ratios = imgs.map((i) => (Number(i.getAttribute('height')) || 0) / (Number(i.getAttribute('width')) || 1));
    const base = Math.min(...ratios.filter((r) => r > 0));
    const isTall = (i: number) => Number.isFinite(base) && ratios[i] > base * TALL;

    const track = document.createElement('div');
    track.className = 'carousel__track';
    track.tabIndex = 0;
    track.setAttribute('role', 'group');
    track.setAttribute('aria-roledescription', 'carousel');
    track.setAttribute('aria-label', 'Screens. Use the arrow keys to move, Enter to enlarge');

    const slides: HTMLElement[] = [];
    let active = 0;

    imgs.forEach((img, i) => {
      const label = img.title || img.alt;
      img.dataset.label = img.title; // the image viewer shows it as the caption
      img.removeAttribute('title'); // no native tooltip over the slide

      const slide = document.createElement('figure');
      slide.className = 'carousel__slide';
      slide.setAttribute('role', 'group');
      slide.setAttribute('aria-roledescription', 'slide');
      slide.setAttribute('aria-label', `${i + 1} of ${n}: ${label}`);
      if (isTall(i)) {
        slide.classList.add('is-cropped');
        slide.style.setProperty('--crop', String(1 / base));
      }
      slide.append(img);
      track.append(slide);
      slides.push(slide);

      // A click on a neighbour brings it to the centre; a click on the centred slide opens the viewer.
      slide.addEventListener(
        'click',
        (e) => {
          if (i === active) return;
          e.stopPropagation();
          goTo(i);
        },
        true,
      );
    });

    const bar = document.createElement('div');
    bar.className = 'carousel__bar';
    const prev = document.createElement('button');
    prev.type = 'button';
    prev.className = 'carousel__btn';
    prev.setAttribute('aria-label', 'Previous screen');
    prev.innerHTML = arrow('M15 5l-7 7 7 7');
    const next = document.createElement('button');
    next.type = 'button';
    next.className = 'carousel__btn';
    next.setAttribute('aria-label', 'Next screen');
    next.innerHTML = arrow('M9 5l7 7-7 7');
    const count = document.createElement('span');
    count.className = 'carousel__count';
    bar.append(prev, count, next);

    root.replaceChildren(track, bar);

    function goTo(i: number, smooth = true) {
      const s = slides[Math.max(0, Math.min(n - 1, i))];
      track.scrollTo({
        left: s.offsetLeft + s.offsetWidth / 2 - track.clientWidth / 2,
        behavior: smooth && !reduced.matches ? 'smooth' : 'auto',
      });
    }

    /** The slide nearest the track's centre (the first and last win at the ends of the track). */
    function nearest() {
      const max = track.scrollWidth - track.clientWidth;
      if (track.scrollLeft <= 2) return 0;
      if (track.scrollLeft >= max - 2) return n - 1;
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let dist = Infinity;
      slides.forEach((s, i) => {
        const d = Math.abs(s.offsetLeft + s.offsetWidth / 2 - mid);
        if (d < dist) {
          dist = d;
          best = i;
        }
      });
      return best;
    }

    function update() {
      active = nearest();
      slides.forEach((s, i) => s.classList.toggle('is-active', i === active));
      count.textContent = `${active + 1} / ${n}`;
      prev.disabled = active === 0;
      next.disabled = active === n - 1;
    }

    let frame = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    new ResizeObserver(update).observe(track);

    prev.addEventListener('click', () => goTo(active - 1));
    next.addEventListener('click', () => goTo(active + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(active - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(active + 1);
      } else if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        imgs[active].click();
      }
    });
    // The image viewer asks the carousel to follow the image it was last showing.
    root.addEventListener('goto', (e) => goTo((e as CustomEvent<number>).detail, false));

    update();
  });
</script>

<style is:global>
  .prose .carousel {
    max-width: none;
    --slide: 82%;
  }
  .carousel__track {
    position: relative;
    display: flex;
    /* Slides of different heights share a centre line instead of stretching to the tallest. */
    align-items: center;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }
  .carousel__track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 10px;
  }
  .carousel__slide {
    flex: 0 0 min(var(--slide), var(--slide-max, 100%));
    margin: 0;
    scroll-snap-align: center;
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
    /* A real border, not a box-shadow ring: the scroll track would clip a ring at its edges. */
    border: 1px solid var(--line);
    filter: brightness(0.94);
    cursor: pointer;
    transition: filter 0.3s ease;
  }
  .carousel__slide.is-active {
    filter: none;
    cursor: zoom-in;
  }
  .carousel__slide img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }
  /* A tall screen shows its top part at the row's proportions; a soft fade hints there is more. */
  .carousel__slide.is-cropped {
    position: relative;
    aspect-ratio: var(--crop);
  }
  .carousel__slide.is-cropped img {
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .carousel__slide.is-cropped::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 22%;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--surface) 92%, transparent));
    pointer-events: none;
  }
  /* The viewer's cursor rule for loose images doesn't apply inside a slide. */
  .carousel__slide img[data-lb] {
    cursor: inherit;
  }

  .carousel__bar {
    margin-top: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .carousel__btn {
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .carousel__btn:hover:not(:disabled) {
    background: var(--line);
  }
  .carousel__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .carousel__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .carousel__count {
    min-width: 56px;
    text-align: center;
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* Caption right after a carousel, like the one after a single image. */
  .prose .carousel + p:has(> em:only-child) {
    margin-top: 16px;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .prose .carousel {
      --slide: 88%;
    }
    .carousel__track {
      gap: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel__slide {
      transition: none;
    }
  }
</style>
