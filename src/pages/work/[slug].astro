---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';
import CaseCover from '../../components/CaseCover.astro';
import ArrowCircle from '../../components/ArrowCircle.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const cases = (await getCollection('cases', (c) => !c.data.hidden)).sort((a, b) => a.data.order - b.data.order);
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}

interface Props {
  entry: CollectionEntry<'cases'>;
  next: CollectionEntry<'cases'>;
}

const { entry, next } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

// Split the title so the accent word(s) get the italic serif treatment.
const accentAt = d.accent ? d.title.lastIndexOf(d.accent) : -1;
const titleHead = accentAt >= 0 ? d.title.slice(0, accentAt) : d.title;
const titleAccent = accentAt >= 0 ? d.accent : undefined;

const facts = [
  { label: 'Role', value: d.role },
  { label: 'Timeline', value: d.timeline },
  { label: 'Company', value: d.company },
  d.team && { label: 'Team', value: d.team },
  d.platforms && { label: 'Platforms', value: d.platforms },
].filter(Boolean) as { label: string; value: string }[];

const og = await getImage({ src: d.cover, width: 1200, format: 'jpg' });
---

<Base title={d.client} description={d.summary} image={og.src} current="work" compactFooter progress>
  <article>
    <header class="container case-hero">
      <a href={url('/#work')} class="case-hero__back arrow-trigger"><ArrowCircle dir="left" />Back</a>
      <p class="eyebrow">Case study · {d.client} · {d.industry}</p>
      <h1 class="h1 case-hero__title">
        {titleHead}{titleAccent && <span class="accent-word">{titleAccent}</span>}
      </h1>
      <p class="lead">{d.lead}</p>
    </header>

    <div class="container">
      <dl class="case-facts" style={`--cols: ${facts.length}`}>
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      {
        d.part?.length > 0 && (
          <section class="case-part" aria-labelledby="my-part">
            <h2 id="my-part" class="case-part__title">My part</h2>
            <ol class="case-part__list" role="list">
              {d.part.map((p, i) => (
                <li>
                  <span class="case-part__num">{String(i + 1).padStart(2, '0')}</span>
                  <span>{p}</span>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        d.stats && (
          <section class="case-stats" aria-label={d.stats.label}>
            <p class="eyebrow case-stats__label">{d.stats.label}</p>
            <div class:list={['case-stats__grid', { 'case-stats__grid--four': d.stats.items.length === 4 }]}>
              {d.stats.items.map((s) => (
                <div>
                  <span class="case-stats__value">{s.value}</span>
                  <span class="case-stats__text">{s.label}</span>
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>

    {
      d.format === 'story' ? (
        <div class="container case-body">
          {toc.length > 1 && (
            <aside class="case-toc">
              <nav aria-label="On this page">
                <p class="eyebrow">On this page</p>
                <ol>
                  {toc.map((h, i) => (
                    <li>
                      <a href={`#${h.slug}`}>
                        <span>{String(i + 1).padStart(2, '0')}</span>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>
          )}
          <div class="prose case-prose">
            <Content />
          </div>
        </div>
      ) : (
        <div class="container case-slides">
          <div class="prose case-prose case-prose--intro">
            <Content />
          </div>
          {d.slides.length > 0 && (
            <div class="slides">
              {d.slides.map((s, i) => (
                <figure class="slide reveal">
                  <Image src={s.src} alt={s.alt} sizes="(min-width: 1440px) 1280px, 100vw" class="slide__img" />
                  <figcaption class="eyebrow">
                    {String(i + 1).padStart(2, '0')} — {s.alt}
                  </figcaption>
                </figure>
              ))}
            </div>
          )}
        </div>
      )
    }

    <ImageCarousel />
    <Lightbox />

    <div class="container">
      <a href={url(`/work/${next.id}/`)} class="next">
        <div class="next__text">
          <p class="eyebrow">Next case · {next.data.industry}</p>
          <p class="next__title">{next.data.client}: {next.data.title} →</p>
        </div>
        <CaseCover
          id={next.id}
          cover={next.data.cover}
          layers={next.data.coverLayers}
          sizes="(min-width: 1024px) 34vw, 100vw"
          class="next__media"
        />
      </a>
    </div>
  </article>
</Base>

<script>
  // A collapsed block gets a second "hide" pill at its end, so a reader who has scrolled
  // through the opened items can close them without going back up. Closing brings the
  // top pill back into view and gives it focus.
  document.querySelectorAll<HTMLDetailsElement>('.prose details.more').forEach((details) => {
    const summary = details.querySelector('summary');
    if (!summary) return;
    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'more__close';
    close.textContent = details.querySelector('.more__hide')?.textContent ?? 'Hide';
    close.addEventListener('click', () => {
      details.open = false;
      summary.scrollIntoView({ block: 'center', behavior: 'instant' });
      summary.focus({ preventScroll: true });
    });
    details.append(close);
  });

  // Highlight the current section in the table of contents.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.case-toc a')];
  const sections = links
    .map((a) => ({ a, el: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
    .filter((s): s is { a: HTMLAnchorElement; el: HTMLElement } => s.el !== null);
  if (sections.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.35;
      // The active section is the last one whose heading has passed the line.
      let active = sections[0];
      for (const s of sections) if (s.el.getBoundingClientRect().top <= line) active = s;
      sections.forEach((s) => (s === active ? s.a.setAttribute('aria-current', 'true') : s.a.removeAttribute('aria-current')));
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  .case-hero {
    padding-top: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(40px, 5vw, 56px);
    display: flex;
    flex-direction: column;
  }
  /* Label sits on its title; the lead follows a little further down. */
  .case-hero .eyebrow {
    margin-top: clamp(16px, 2vw, 24px);
  }
  .case-hero__title {
    margin-top: 16px;
  }
  .case-hero .lead {
    margin-top: clamp(20px, 2.4vw, 28px);
  }
  .case-hero__back {
    align-self: flex-start;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.18s ease-out;
  }
  /* Same hover as "Read case": the label lights up, the arrow circle draws its ring (global.css). */
  @media (hover: hover) {
    .case-hero__back:hover {
      color: var(--accent-ink);
    }
  }
  .case-hero__back:focus-visible {
    color: var(--accent-ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .case-hero__back {
      transition: none;
    }
  }
  .case-hero__title {
    max-width: 1200px;
  }

  .case-facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 20px 24px;
  }
  .case-facts div {
    border-top: 1px solid var(--rule);
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .case-facts dt {
    font-size: 14px;
    color: var(--muted);
  }
  .case-facts dd {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
  }

  /* "My part": the title on the left, numbered rows on the right, ruled like the
     experience list on the home page — a strong rule on top, light ones between. */
  .case-part {
    margin-top: clamp(56px, 7vw, 88px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
  }
  .case-part__title {
    grid-column: span 4;
    margin: 0;
    font-size: var(--step-h3);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .case-part__list {
    grid-column: 5 / span 8;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .case-part__list li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .case-part__list li:first-child {
    border-top-color: var(--rule);
  }
  .case-part__list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .case-part__num {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--accent-ink);
  }

  .case-stats {
    margin-top: 48px;
    padding: clamp(28px, 4vw, 40px) clamp(24px, 4vw, 48px);
    border-radius: var(--radius);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .case-stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 32px 48px;
  }
  /* Four numbers go two by two until they fit in one row, so none is left alone. */
  @media (max-width: 1199px) {
    .case-stats__grid--four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .case-stats__grid--four {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .case-stats__grid div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .case-stats__value {
    font-size: clamp(3rem, 2rem + 3vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.05em;
    font-weight: 500;
  }
  .case-stats__text {
    font-size: 16px;
    line-height: 1.45;
    color: var(--ink-3);
  }

  .case-body {
    margin-top: clamp(72px, 9vw, 120px);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
  }
  .case-toc {
    grid-column: span 3;
  }
  .case-toc nav {
    position: sticky;
    top: 120px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .case-toc ol {
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
  }
  .case-toc a {
    display: flex;
    gap: 12px;
    padding: 6px 0;
    color: var(--muted);
  }
  .case-toc a span {
    font-family: var(--mono);
    font-size: 13px;
  }
  .case-toc a[aria-current] {
    color: var(--ink);
    font-weight: 500;
  }
  .case-toc a[aria-current] span {
    color: var(--accent-ink);
  }
  .case-prose {
    grid-column: 4 / span 9;
    min-width: 0;
  }

  .case-slides {
    margin-top: clamp(72px, 9vw, 120px);
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 7vw, 96px);
  }
  .slides {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 56px);
  }
  .slide {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .slide :global(.slide__img) {
    width: 100%;
    border-radius: 14px;
    border: 1px solid var(--line);
  }

  .next {
    margin-top: clamp(96px, 12vw, 144px);
    padding: 48px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 24px;
    align-items: center;
  }
  .next:hover {
    color: var(--ink);
  }
  .next__text {
    grid-column: span 7;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .next__title {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-weight: 500;
    text-wrap: balance;
  }
  .next:hover .next__title {
    color: var(--accent-ink);
  }
  .next :global(.next__media) {
    grid-column: 9 / span 4;
    aspect-ratio: 16 / 10;
  }

  @media (max-width: 1023px) {
    .case-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .case-part {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .case-part__title,
    .case-part__list {
      grid-column: auto;
    }
    .case-part__list li {
      grid-template-columns: 32px minmax(0, 1fr);
      gap: 12px;
    }
    .case-body {
      grid-template-columns: 1fr;
    }
    .case-toc {
      display: none;
    }
    .case-prose {
      grid-column: auto;
    }
    .next {
      grid-template-columns: 1fr;
    }
    .next__text,
    .next :global(.next__media) {
      grid-column: auto;
    }
  }
</style>
