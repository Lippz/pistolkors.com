---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CaseFeature from '../components/CaseFeature.astro';
import CaseCard from '../components/CaseCard.astro';
import MotionLab from '../components/MotionLab.astro';
import Capabilities from '../components/Capabilities.astro';
import Testimonials from '../components/Testimonials.astro';
import AiPipeline from '../components/AiPipeline.astro';
import Lightbox from '../components/Lightbox.astro';
import { site, facts, experience } from '../data/site';
import { PRODUCT_SINCE, yearsSince, inWords } from '../lib/years';
import portrait from '../assets/site/portrait.webp';

const cases = (await getCollection('cases', (c) => !c.data.hidden && !c.data.draft)).sort((a, b) => a.data.order - b.data.order);
const featured = cases.filter((c) => c.data.featured);
const rest = cases.filter((c) => !c.data.featured);

// Hero: hovering "complex" throws its letters out of line — shifted, tilted, too light or
// too heavy — and they settle back into an even word when the pointer leaves.
const mess = [
  { c: 'c', y: -0.09, r: -6, w: 400 },
  { c: 'o', y: 0.07, r: 5, w: 650 },
  { c: 'm', y: -0.03, r: -3, w: 450 },
  { c: 'p', y: 0.11, r: 7, w: 600 },
  { c: 'l', y: -0.12, r: -4, w: 375 },
  { c: 'e', y: 0.05, r: 6, w: 625 },
  { c: 'x', y: -0.07, r: -8, w: 425 },
];
---

<Base>
  <section class="hero container">
    <p class="eyebrow hero__status"><span class="dot" aria-hidden="true"></span>{site.availability}</p>
    <div class="hero__main">
      <h1 class="h-hero hero__title">
        <span class="sr-only">I help complex products feel obvious</span>
        <span aria-hidden="true">
          <span class="lead-in">I help</span>{' '}
          <span class="mess">
            {mess.map((l, i) => <span style={`--y:${l.y}em;--r:${l.r}deg;--w:${l.w};--i:${i}`}>{l.c}</span>)}
          </span>{' '}
          products feel <span class="bar-right hero__accent">obvious</span>
        </span>
      </h1>
    </div>
    <div class="hero__ctas">
      <a href="#work" class="btn btn--accent hero__work">View recent works</a>
      <div class="btn-split" role="group" aria-label="CV (PDF)">
        <a href={site.cv} class="btn-split__part" download>Download CV (PDF)</a>
        <a href={site.cv} class="btn-split__part" target="_blank" rel="noopener">View CV</a>
      </div>
    </div>
  </section>
  <!-- Hide the bar under "obvious" before the first paint; the page script draws it in
       after "complex" has shown off. Six seconds on, it shows anyway, in case that script
       never runs. -->
  <script is:inline>
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || scrollY > 2) return;
      var root = document.documentElement;
      root.classList.add('hero-wait');
      setTimeout(function () {
        root.classList.remove('hero-wait');
      }, 6000);
    })();
  </script>

  <section class="intro container">
    <p class="intro__text">
      <span class="intro__role">Senior Product Designer</span> at Existek, with{' '}
      <span data-since={PRODUCT_SINCE} data-as="word">{inWords(yearsSince(PRODUCT_SINCE))}</span> years in product design
      across healthcare, legal-tech, e-commerce and construction. I run discovery, build the system and sweat the
      interaction details.
    </p>
    <ul class="facts" role="list">
      {
        facts.map((f) => (
          <li>
            <span class="facts__value">
              {f.since ? (
                <>
                  <span data-since={f.since}>{yearsSince(f.since)}</span> {f.unit}
                </>
              ) : (
                f.value
              )}
            </span>
            <span class="facts__label">{f.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="work" class="work">
    <div class="container work__inner">
      <div class="section-head">
        <h2 class="h2"><span class="bar-left"><b>Recent</b></span> works</h2>
      </div>

      {featured.map((entry, i) => <CaseFeature entry={entry} index={i + 1} flip={i % 2 === 1} />)}

      <div class="work__grid">
        {rest.map((entry) => <CaseCard entry={entry} />)}
      </div>
    </div>
  </section>

  <Testimonials />

  <MotionLab />

  <Capabilities />

  <AiPipeline />

  <section id="about" class="about container">
    <div class="about__photo frame reveal">
      <Image src={portrait} alt="Pylyp Pistolkors" sizes="(min-width: 1024px) 40vw, 100vw" />
    </div>
    <div class="about__body">
      <h2 class="h2"><span class="bar-right"><b>About</b></span></h2>
      <p class="about__text">
        I started in 2005 animating casino games and banner ads, moved into product design at RIA.com, and now lead
        design at Existek — on LinkHMS, our own hospital system, and on client products. The motion background is my edge: I prototype
        interactions, so engineers get behaviour, not guesses. Off-screen I produce electronic music and games.
      </p>
      <ul class="xp" role="list">
        {
          experience.map((x) => (
            <li>
              <div>
                <span class="xp__role">{x.role}</span>
                <span class="xp__detail">{x.detail}</span>
              </div>
              <span class="xp__period">{x.period}</span>
            </li>
          ))
        }
      </ul>
      <dl class="details">
        {
          site.details.map((d) => (
            <div>
              <dt>{d.label}</dt>
              <dd>{d.value}</dd>
            </div>
          ))
        }
      </dl>
      <a href={site.cv} class="btn btn--outline about__cv" download>Download CV (PDF)</a>
    </div>
  </section>

  <Lightbox />
</Base>

<script>
  // "obvious" glint: start on pointer enter, let it finish on its own, and ignore new
  // hovers until it has. The CSS only runs it where hover and motion are welcome.
  // Not while the bar is still to be drawn: the glint is a light band over it.
  const root = document.documentElement;
  const accent = document.querySelector<HTMLElement>('.hero__accent');
  accent?.addEventListener('pointerenter', () => {
    if (!root.classList.contains('hero-wait')) accent.classList.add('is-glinting');
  });
  accent?.addEventListener('animationend', (e) => {
    if (e.animationName.includes('glint')) accent.classList.remove('is-glinting');
  });

  // As the page opens, a red bar sweeps along "I help" (see the CSS): out of the left edge
  // of the screen to the end of "help", where it collapses. The CSS only runs it where
  // motion is welcome. "complex" used to throw its letters out of line meanwhile, a hint
  // that the word reacts to the pointer; that is off for now (is-messy, commented out
  // below and in the CSS).
  const sweepAt = 0;
  const sweepFor = 900;
  const overlap = 500; // "obvious" starts this much before the sweep has finished
  const leadIn = document.querySelector<HTMLElement>('.lead-in');
  if (leadIn) {
    // How far the bar comes from (the screen's edge) and goes to (just past "help"),
    // measured from the start of the words.
    const fontSize = parseFloat(getComputedStyle(leadIn).fontSize);
    leadIn.style.setProperty('--to-edge', `${Math.ceil(leadIn.getBoundingClientRect().left)}px`);
    leadIn.style.setProperty('--sweep-end', `${leadIn.offsetWidth + fontSize * 0.04}px`);
    leadIn.style.setProperty('--sweep', `${sweepFor}ms`);
    leadIn.classList.add('sweep-ready');
    setTimeout(() => {
      leadIn.classList.add('is-sweeping');
      // document.querySelector('.mess')?.classList.add('is-messy');
      setTimeout(() => leadIn.classList.remove('is-sweeping'), sweepFor);
    }, sweepAt);
  }

  // Then "obvious" draws its bar, out to the screen's edge, setting off just before the
  // sweep has finished collapsing so the two overlap a little.
  // Skipped if the page has already been scrolled away from the top, or once the user has
  // moved on.
  if (accent && root.classList.contains('hero-wait')) {
    const done = () => {
      accent.classList.remove('is-drawing');
      root.classList.remove('hero-wait');
    };
    accent.addEventListener('animationend', (e) => {
      if (e.animationName.includes('hero-bar-draw')) done();
    });
    if (scrollY > 2) done();
    else
      setTimeout(() => {
        if (!accent.classList.contains('is-on')) return done();
        const start = accent.getBoundingClientRect().left + parseFloat(getComputedStyle(accent).fontSize) * 0.08;
        accent.style.setProperty('--bar-reach', `${Math.ceil(innerWidth - start)}px`);
        accent.classList.add('is-drawing');
      }, sweepAt + sweepFor - overlap);
  }

  // The page moves section by section. Inside a section taller than the screen (the
  // works, the quotes, About on a phone) scrolling is ordinary, up to the section's edge:
  // its start right under the header, or its end at the bottom of the screen. From an edge
  // the next gesture moves on to the neighbouring section — down to the next one's start,
  // up to the previous one's end, so nothing is skipped. A short section is all edge, so
  // one notch moves past it.
  const scenes = [
    ...document.querySelectorAll<HTMLElement>('main :is(.hero, .intro, #work, #words, #how, #ai, #lab, #about)'),
  ];
  const header = document.querySelector<HTMLElement>('.header');
  const footer = document.querySelector<HTMLElement>('.footer');
  const calm = matchMedia('(prefers-reduced-motion: reduce)');

  type Stop = { y: number; el: HTMLElement };
  type Section = { start: number; end: number; el: HTMLElement };
  // Layout position, ignoring transforms (the reveal and section animations move things).
  const docTop = (el: HTMLElement) => {
    let y = 0;
    for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) y += n.offsetTop;
    return y;
  };
  let sectionCache: { at: number; sections: Section[] } | undefined;
  const sectionsNow = (): Section[] => {
    if (sectionCache && performance.now() - sectionCache.at < 500) return sectionCache.sections;
    const top = header?.offsetHeight ?? 0;
    const last = document.documentElement.scrollHeight - innerHeight;
    const clamp = (y: number) => Math.max(0, Math.min(last, Math.round(y)));
    const sections = [...scenes, ...(footer ? [footer] : [])].map((el) => {
      const start = clamp(docTop(el) - top);
      const end = el === footer ? last : clamp(docTop(el) + el.offsetHeight - innerHeight);
      return { start, end: Math.max(start, end), el };
    });
    sectionCache = { at: performance.now(), sections };
    return sections;
  };
  window.addEventListener('resize', () => (sectionCache = undefined));
  // The section the page is in: the last one whose start it has reached.
  const sectionAt = (y: number) => {
    const sections = sectionsNow();
    let i = 0;
    while (i + 1 < sections.length && sections[i + 1].start <= y + 2) i++;
    return { sections, i };
  };

  // The red bar is handed from heading to heading, one at a time. A heading holds it while
  // the page rests at the start of its section: the bar arrives as the page moves there and
  // leaves the moment you scroll on, a few percent of the screen either way. When the next
  // heading takes it the bar slides off one word and in under the other. Bars that are off
  // wait beyond their edge of the screen — out to the right, in from the left, and so on.
  // Without the script, or with reduced motion, every bar simply stays in place.
  const bars = calm.matches
    ? []
    : [...document.querySelectorAll<HTMLElement>(':is(main, .footer) :is(.bar-left, .bar-right)')];
  let barOn: HTMLElement | undefined;
  let barLanding = false; // the bar was handed over by a move that is still running
  const showBar = (bar: HTMLElement | undefined) => {
    if (bar === barOn) return;
    barOn?.classList.remove('is-on');
    bar?.classList.add('is-on');
    barOn = bar;
  };
  const heroBar = bars.find((bar) => bar.closest('.hero'));
  // "Recent works" names everything below it, so it keeps the bar for as long as the
  // section is in focus — running through the middle of the screen under the header —
  // not only at its start.
  const workBar = bars.find((bar) => bar.closest('#work'));
  const restFor = (bar: HTMLElement) => sectionsNow().find((s) => s.el.contains(bar))?.start ?? 0;
  let barQueued = false;
  const pickBar = () => {
    barQueued = false;
    if (barLanding) return;
    showBar(
      bars
        .filter((bar) => {
          if (bar === workBar) {
            const work = bar.closest<HTMLElement>('section')?.getBoundingClientRect();
            const top = header?.offsetHeight ?? 0;
            const middle = top + (innerHeight - top) / 2;
            return !!work && work.top <= middle && work.bottom >= middle;
          }
          // "obvious" is the page's opening line: it keeps the bar a touch longer.
          return Math.abs(scrollY - restFor(bar)) < innerHeight * (bar === heroBar ? 0.05 : 0.04);
        })
        .at(-1),
    );
  };
  if (bars.length) {
    pickBar();
    document.documentElement.classList.add('bars-live');
    const queue = () => {
      if (!barQueued) {
        barQueued = true;
        requestAnimationFrame(pickBar);
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
  }

  // A move to another section runs exactly like the bar comes in — same length, same
  // curve, read from the --bar-in-* properties in global.css — so page and bar arrive
  // together. Reaching a section's edge from inside it is just a short ease.
  const rootStyle = getComputedStyle(document.documentElement);
  const moveDuration = parseFloat(rootStyle.getPropertyValue('--bar-in-duration')) * 1000 || 900;
  const [x1, y1, x2, y2] = (rootStyle.getPropertyValue('--bar-in-ease').match(/-?[\d.]+/g) ?? ['0.45', '0', '0.2', '1']).map(Number);
  const bezier = (p1: number, p2: number, t: number) => 3 * p1 * t * (1 - t) ** 2 + 3 * p2 * t ** 2 * (1 - t) + t ** 3;
  const moveEase = (x: number) => {
    // Find the curve's t for this point in time (x), then its progress (y).
    let lo = 0;
    let hi = 1;
    for (let i = 0; i < 20; i++) {
      const mid = (lo + hi) / 2;
      if (bezier(x1, x2, mid) < x) lo = mid;
      else hi = mid;
    }
    return bezier(y1, y2, (lo + hi) / 2);
  };
  const easeOut = (t: number) => 1 - (1 - t) ** 3;

  let glide = 0;
  function moveTo(stop: Stop, short = false) {
    // The section's heading takes the bar as the move begins, so it lands with the page;
    // a stop away from a heading sends the last bar away.
    if (bars.length && !short) {
      showBar(
        bars.find((bar) => Math.abs(restFor(bar) - stop.y) < 2) ??
          (workBar && stop.el.contains(workBar) ? workBar : undefined),
      );
      barLanding = true;
    }
    const land = () => {
      glide = 0;
      barLanding = false;
      lastY = scrollY;
    };
    cancelAnimationFrame(glide);
    if (calm.matches) {
      window.scrollTo({ top: stop.y, behavior: 'instant' });
      land();
      return;
    }
    const from = scrollY;
    const distance = stop.y - from;
    const duration = short ? 300 : moveDuration;
    const ease = short ? easeOut : moveEase;
    const start = performance.now();
    const tick = (now: number) => {
      // A frame's timestamp can be from just before the move started; never run backwards.
      const t = Math.min(1, Math.max(0, (now - start) / duration));
      window.scrollTo({ top: from + distance * ease(t), behavior: 'instant' });
      if (t < 1) glide = requestAnimationFrame(tick);
      else land();
    };
    glide = requestAnimationFrame(tick);
  }

  // Where a move of `delta` pixels from here should go. Inside a section it is ordinary
  // scrolling (undefined), cut short at the section's edge; at an edge it is the
  // neighbouring section — if `leave` allows leaving.
  type Plan = { to: Stop; short: boolean } | 'stay' | undefined;
  function plan(delta: number, leave: boolean): Plan {
    const dir = Math.sign(delta);
    const { sections, i } = sectionAt(scrollY);
    const here = sections[i];
    const y = scrollY;
    if (dir > 0) {
      if (y < here.end - 2) return y + delta <= here.end ? undefined : { to: { y: here.end, el: here.el }, short: true };
      const next = sections[i + 1];
      if (!next) return 'stay';
      return leave ? { to: { y: next.start, el: next.el }, short: false } : 'stay';
    }
    if (y > here.start + 2) {
      // Between this section's end and the next one's start belongs to neither: go back up
      // to the end like any other edge.
      if (y > here.end + 2) return leave ? { to: { y: here.end, el: here.el }, short: false } : 'stay';
      return y + delta >= here.start ? undefined : { to: { y: here.start, el: here.el }, short: true };
    }
    const prev = sections[i - 1];
    if (!prev) return 'stay';
    return leave ? { to: { y: prev.end, el: prev.el }, short: false } : 'stay';
  }

  // The wheel. A gesture is a run of wheel events with no pause longer than 200ms — a
  // notch (smooth-scrolling wheels send several events for one), or a trackpad flick and
  // all its momentum. A gesture that starts at a section's edge moves to the next section,
  // once; one that starts inside scrolls normally and stops at the edge, even if its
  // momentum would carry on. Sideways scrolling (the Interactions carousel) is left alone,
  // as are pinch-zoom and the image viewer.
  const notThePage = (e: Event) => (e as WheelEvent).ctrlKey || document.querySelector('dialog[open]') !== null;
  let lastWheelAt = -Infinity;
  let gestureSpent = false; // this gesture has already moved the page by itself
  // A mostly sideways gesture over something that scrolls sideways is left to it; anywhere
  // else its vertical part is the page's, or a slanted trackpad swipe would carry the page
  // past a section's edge.
  const scrollsSideways = (target: EventTarget | null) => {
    for (let n = target instanceof Element ? target : null; n && n !== document.body; n = n.parentElement) {
      if (n.scrollWidth > n.clientWidth + 1 && /auto|scroll/.test(getComputedStyle(n).overflowX)) return true;
    }
    return false;
  };
  function onWheel(e: WheelEvent) {
    if (notThePage(e)) return;
    if (Math.abs(e.deltaX) > Math.abs(e.deltaY) && scrollsSideways(e.target)) return;
    const now = performance.now();
    const fresh = now - lastWheelAt > 200;
    lastWheelAt = now;
    if (fresh) gestureSpent = false;
    if (glide || gestureSpent) return e.preventDefault();
    const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? innerHeight : 1;
    const delta = e.deltaY * unit;
    if (!delta) return;
    // Only a gesture's first event may leave the section.
    const next = plan(delta, fresh);
    if (next === undefined) return; // ordinary scrolling inside the section
    e.preventDefault();
    if (next === 'stay') return;
    gestureSpent = true;
    moveTo(next.to, next.short);
  }

  // Page keys work the same way: inside a section they scroll as usual, at its edge they
  // move to the next section. Home and End go to the top and the bottom.
  function onKey(e: KeyboardEvent) {
    if (notThePage(e) || e.altKey || e.ctrlKey || e.metaKey) return;
    if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
    const page = innerHeight - (header?.offsetHeight ?? 0) - 40;
    const delta =
      ({ ArrowDown: 80, ArrowUp: -80, PageDown: page, PageUp: -page } as Record<string, number>)[e.key] ??
      (e.key === ' ' && !(e.target as HTMLElement).closest('button, a') ? (e.shiftKey ? -page : page) : 0);
    if (e.key === 'Home' || e.key === 'End') {
      e.preventDefault();
      const sections = sectionsNow();
      const s = e.key === 'Home' ? sections[0] : sections.at(-1);
      if (s && !glide) moveTo({ y: e.key === 'Home' ? s.start : s.end, el: s.el });
      return;
    }
    if (!delta) return;
    if (glide) return e.preventDefault();
    const next = plan(delta, true);
    if (next === undefined) return;
    e.preventDefault();
    if (next !== 'stay') moveTo(next.to, next.short);
  }

  // Touch scrolls natively. If a swipe leaves the page between two sections — the end of
  // one and the start of the next both partly on screen — it moves on to the section in
  // the swipe's direction.
  let lastY = scrollY;
  let swipeDir = 0;
  let touchedAt = -Infinity;
  function onScroll() {
    if (glide) return;
    if (scrollY !== lastY) swipeDir = Math.sign(scrollY - lastY);
    lastY = scrollY;
  }
  function settle() {
    if (glide || performance.now() - touchedAt > 1500 || !swipeDir) return;
    const { sections, i } = sectionAt(scrollY);
    const here = sections[i];
    const next = sections[i + 1];
    if (!next || scrollY <= here.end + 2) return;
    moveTo(swipeDir > 0 ? { y: next.start, el: next.el } : { y: here.end, el: here.el });
  }

  // Links to a section of this page — the menu, the logo, the buttons — move the page like
  // a section change does, so the heading's bar sets off with the click instead of waiting
  // for the browser's own smooth scroll to finish. The header's handlers still close the
  // menu; the address still gets the section's hash.
  function onLinkClick(e: MouseEvent) {
    if (e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[href]');
    if (!link || link.origin !== location.origin || link.pathname !== location.pathname) return;
    const target = link.hash ? document.getElementById(decodeURIComponent(link.hash.slice(1))) : scenes[0];
    const section = target && sectionsNow().find((s) => s.el === target || s.el.contains(target));
    if (!section) return;
    e.preventDefault();
    if (link.hash !== location.hash) history.pushState(null, '', link.pathname + location.search + link.hash);
    moveTo({ y: section.start, el: section.el });
  }

  if (scenes.length) {
    document.addEventListener('click', onLinkClick);
    window.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('keydown', onKey);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('touchmove', () => (touchedAt = performance.now()), { passive: true });
    window.addEventListener('touchend', () => (touchedAt = performance.now()), { passive: true });
    // scrollend where supported; elsewhere, a short pause after the last scroll event.
    if ('onscrollend' in document.documentElement) {
      window.addEventListener('scrollend', settle);
    } else {
      let idle = 0;
      window.addEventListener('scroll', () => {
        clearTimeout(idle);
        idle = window.setTimeout(settle, 150);
      }, { passive: true });
    }
  }
</script>

<style>
  /* The hero always fills the screen under the sticky header (its height + 1px border):
     svh, not vh, so mobile browser bars never cut the bottom off. It sits in the site
     container like the header and the sections below, with the gutter above and below it
     too. The status sits at the top, the buttons at the bottom with the title just above
     them; the gap is the least room between the three when content is taller than the screen. */
  .hero {
    min-height: calc(100svh - var(--header-h) - 1px);
    padding: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  /* The title drops to the buttons, leaving the free space above it. */
  .hero__main {
    margin-top: auto;
    margin-bottom: calc(clamp(32px, 3.5vw, 44px) - 24px);
  }
  /* The title grows with the screen width from 72px on phones up to 156px, one and a half
     times the site's hero size, which it reaches at 1440 as the container stops growing
     (10.8vw). The screen height
     caps it: what is left of the hero after the gutters and about 160px for the status,
     buttons and gaps, shared by three lines at 0.95 — so even a title broken into three
     lines fits. Set a little tighter. */
  .hero__title {
    font-size: min(
      max(4.5rem, 10.8vw),
      9.75rem,
      calc((100svh - var(--header-h) - 1px - 2 * var(--gutter) - 160px) / 2.85)
    );
    line-height: 0.95;
    isolation: isolate; /* keeps the red bar under "obvious" above the page background */
  }
  /* "obvious" is a bar-right like the section headings, tuned for the hero: a heavier word
     and a bar fitted to the tighter line. */
  .hero__accent {
    position: relative;
    display: inline-block;
    padding: 0 0.12em;
    margin: 0 -0.12em;
