---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CaseFeature from '../components/CaseFeature.astro';
import CaseCard from '../components/CaseCard.astro';
import MotionLab from '../components/MotionLab.astro';
import Capabilities from '../components/Capabilities.astro';
import Testimonials from '../components/Testimonials.astro';
import AiPipeline from '../components/AiPipeline.astro';
import Lightbox from '../components/Lightbox.astro';
import { site, facts, experience } from '../data/site';
import { PRODUCT_SINCE, yearsSince, inWords } from '../lib/years';
import portrait from '../assets/site/portrait.webp';

const cases = (await getCollection('cases', (c) => !c.data.hidden && !c.data.draft)).sort((a, b) => a.data.order - b.data.order);
const featured = cases.filter((c) => c.data.featured);
const rest = cases.filter((c) => !c.data.featured);

// Hero: hovering "complex" throws its letters out of line — shifted, tilted, too light or
// too heavy — and they settle back into an even word when the pointer leaves.
const mess = [
  { c: 'c', y: -0.09, r: -6, w: 400 },
  { c: 'o', y: 0.07, r: 5, w: 650 },
  { c: 'm', y: -0.03, r: -3, w: 450 },
  { c: 'p', y: 0.11, r: 7, w: 600 },
  { c: 'l', y: -0.12, r: -4, w: 375 },
  { c: 'e', y: 0.05, r: 6, w: 625 },
  { c: 'x', y: -0.07, r: -8, w: 425 },
];
---

<Base>
  <section class="hero container">
    <p class="eyebrow hero__status"><span class="dot" aria-hidden="true"></span>{site.availability}</p>
    <div class="hero__main">
      <h1 class="h-hero hero__title">
        <span class="sr-only">I help complex products feel obvious</span>
        <span aria-hidden="true">
          I help{' '}
          <span class="mess">
            {mess.map((l, i) => <span style={`--y:${l.y}em;--r:${l.r}deg;--w:${l.w};--i:${i}`}>{l.c}</span>)}
          </span>{' '}
          products feel <span class="accent-word bar-right hero__accent">obvious</span>
        </span>
      </h1>
    </div>
    <div class="hero__ctas">
      <a href="#work" class="btn btn--accent hero__work">View recent works</a>
      <div class="btn-split" role="group" aria-label="CV (PDF)">
        <a href={site.cv} class="btn-split__part" download>Download CV (PDF)</a>
        <a href={site.cv} class="btn-split__part" target="_blank" rel="noopener">View CV</a>
      </div>
    </div>
  </section>

  <section class="intro container">
    <p class="intro__text">
      <span class="intro__role">Senior Product Designer</span> at Existek, with{' '}
      <span data-since={PRODUCT_SINCE} data-as="word">{inWords(yearsSince(PRODUCT_SINCE))}</span> years in product design
      across healthcare, legal-tech, e-commerce and construction. I run discovery, build the system and sweat the
      interaction details.
    </p>
    <ul class="facts" role="list">
      {
        facts.map((f) => (
          <li>
            <span class="facts__value">
              {f.since ? (
                <>
                  <span data-since={f.since}>{yearsSince(f.since)}</span> {f.unit}
                </>
              ) : (
                f.value
              )}
            </span>
            <span class="facts__label">{f.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="work" class="work">
    <div class="container work__inner">
      <div class="section-head">
        <h2 class="h2"><span class="bar-left"><b>Recent</b></span> works</h2>
      </div>

      {featured.map((entry, i) => <CaseFeature entry={entry} index={i + 1} flip={i % 2 === 1} />)}

      <div class="work__grid">
        {rest.map((entry) => <CaseCard entry={entry} />)}
      </div>
    </div>
  </section>

  <Testimonials />

  <Capabilities />

  <AiPipeline />

  <MotionLab />

  <section id="about" class="about container">
    <div class="about__photo frame reveal">
      <Image src={portrait} alt="Pylyp Pistolkors" sizes="(min-width: 1024px) 40vw, 100vw" />
    </div>
    <div class="about__body">
      <h2 class="h2"><span class="bar-right"><b>About</b></span></h2>
      <p class="about__text">
        I started in 2005 animating casino games and banner ads, moved into product design at RIA.com, and now lead
        design at Existek — on LinkHMS, our own hospital system, and on client products. The motion background is my edge: I prototype
        interactions, so engineers get behaviour, not guesses. Off-screen I produce electronic music and games.
      </p>
      <ul class="xp" role="list">
        {
          experience.map((x) => (
            <li>
              <div>
                <span class="xp__role">{x.role}</span>
                <span class="xp__detail">{x.detail}</span>
              </div>
              <span class="xp__period">{x.period}</span>
            </li>
          ))
        }
      </ul>
      <dl class="details">
        {
          site.details.map((d) => (
            <div>
              <dt>{d.label}</dt>
              <dd>{d.value}</dd>
            </div>
          ))
        }
      </dl>
      <a href={site.cv} class="btn btn--outline about__cv" download>Download CV (PDF)</a>
    </div>
  </section>

  <Lightbox />
</Base>

<script>
  // "obvious" glint: start on pointer enter, let it finish on its own, and ignore new
  // hovers until it has. The CSS only runs it where hover and motion are welcome.
  const accent = document.querySelector<HTMLElement>('.hero__accent');
  accent?.addEventListener('pointerenter', () => accent.classList.add('is-glinting'));
  accent?.addEventListener('animationend', () => accent.classList.remove('is-glinting'));

  // "complex" shows off once by itself: 1.5s after the page loads its letters fall out of
  // line, hold for a moment and settle back — a hint that the word reacts to the pointer.
  // The CSS only moves them where motion is welcome.
  const mess = document.querySelector<HTMLElement>('.mess');
  if (mess) {
    setTimeout(() => {
      mess.classList.add('is-messy');
      setTimeout(() => mess.classList.remove('is-messy'), 900);
    }, 1500);
  }

  // Sections the page snaps to (see onScroll below), and the header they sit under.
  const scenes = [
    ...document.querySelectorAll<HTMLElement>('main :is(.hero, .intro, #work, #words, #how, #ai, #lab, #about)'),
  ];
  const header = document.querySelector<HTMLElement>('.header');
  const calm = matchMedia('(prefers-reduced-motion: reduce)');

  // The red bar is handed from heading to heading, one at a time. A heading holds it while
  // the page rests at the start of its section: it arrives as the page snaps there (see
  // snapTo below) and leaves the moment you scroll on, a few percent of the screen either
  // way, while its word is still in view. When the next heading takes it the
  // bar slides off one word and in under the other. Bars that are off wait beyond their
  // edge of the screen — out to the right, in from the left, and so on. Without the
  // script, or with reduced motion, every bar simply stays in place.
  const bars = calm.matches
    ? []
    : [...document.querySelectorAll<HTMLElement>(':is(main, .footer) :is(.bar-left, .bar-right)')];
  let barOn: HTMLElement | undefined;
  let barLanding = false; // the bar was handed over by a glide that is still running
  const showBar = (bar: HTMLElement | undefined) => {
    if (bar === barOn) return;
    barOn?.classList.remove('is-on');
    bar?.classList.add('is-on');
    barOn = bar;
  };
  // Where the page rests for a section: its start right under the header. The footer rests
  // at the bottom of the page, or at its own start when it is taller than the screen, so
  // its heading stays in view. The snap uses the same stops.
  const footer = document.querySelector<HTMLElement>('.footer');
  const restOf = (el: HTMLElement) => {
    const start = el.getBoundingClientRect().top + scrollY - (header?.offsetHeight ?? 0);
    return el === footer ? Math.min(start, document.documentElement.scrollHeight - innerHeight) : start;
  };
  const heroBar = bars.find((bar) => bar.closest('.hero'));
  const restFor = (bar: HTMLElement) => restOf(scenes.find((s) => s.contains(bar)) ?? footer ?? bar);
  let barQueued = false;
  const pickBar = () => {
    barQueued = false;
    if (barLanding) return;
    const top = header?.getBoundingClientRect().bottom ?? 0;
    showBar(
      bars
        .filter((bar) => {
          if (bar.getBoundingClientRect().top < top) return false;
          // "obvious" is the page's opening line: it keeps the bar all through the first
          // screen, until the page snaps on to the next section.
          if (bar === heroBar) return true;
          return Math.abs(scrollY - restFor(bar)) < innerHeight * 0.04;
        })
        .at(-1),
    );
  };
  if (bars.length) {
    pickBar();
    document.documentElement.classList.add('bars-live');
    const queue = () => {
      if (!barQueued) {
        barQueued = true;
        requestAnimationFrame(pickBar);
      }
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
  }
  let glide = 0;
  let lastY = scrollY;
  let lockedUntil = 0; // after landing, scroll input is swallowed until then
  let landedAt = 0;
  let userScrolledAt = -Infinity; // wheel, drag or scroll key; links and taps don't count
  let touchY = 0;

  const stopsNow = () => [...scenes, ...(footer ? [footer] : [])].map((el) => ({ y: restOf(el), el }));

  // speed: how fast the page was already moving (px/ms), so the snap carries on from it
  // instead of kicking off at its own pace.
  function snapTo(stop: { y: number; el: HTMLElement | null }, speed = 0) {
    // The section's heading takes the bar as the snap begins, so it lands with the page; a
    // section without one (the intro) just sends the last bar away.
    const bar = stop.el?.querySelector<HTMLElement>('.bar-left, .bar-right');
    if (bars.length) {
      showBar(bar && bars.includes(bar) ? bar : undefined);
      barLanding = true;
    }
    const land = () => {
      glide = 0;
      barLanding = false;
      landedAt = performance.now();
      lockedUntil = landedAt + 450;
      lastY = scrollY;
    };
    if (calm.matches) {
      window.scrollTo({ top: stop.y, behavior: 'instant' });
      land();
      return;
    }
    const from = scrollY;
    const distance = stop.y - from;
    const duration = 260 + Math.min(200, Math.abs(distance) * 0.3);
    // A Hermite curve: leaves at the speed the page already had and comes to rest on the
    // stop. The starting push is capped at twice the distance so it never overshoots, and
    // dropped when the page was moving the other way (snapping back to a crossed stop).
    const push = Math.sign(speed) === Math.sign(distance) ? Math.min(Math.abs(speed * duration), 2 * Math.abs(distance)) * Math.sign(distance) : 0;
    const curve = (t: number) => push * (t ** 3 - 2 * t ** 2 + t) + distance * (3 * t ** 2 - 2 * t ** 3);
    const start = performance.now();
    const step = (now: number) => {
      // A frame's timestamp can be from just before the snap started; never run backwards.
      const t = Math.min(1, Math.max(0, (now - start) / duration));
      window.scrollTo({ top: from + curve(t), behavior: 'instant' });
      if (t < 1) glide = requestAnimationFrame(step);
      else land();
    };
    glide = requestAnimationFrame(step);
  }

  // Section snap. As soon as the next section's top rises above the bottom 15% of the
  // screen — or the page crosses a section's start in one go — the page snaps to it, so
  // the section sits just under the header (the footer snaps to the bottom). Scrolling
  // up, a section snaps back to its start once you are less than that far into it. Then
  // the page holds still for a
  // moment so one flick moves one section: input is swallowed for about half a second,
  // and a trackpad's fading momentum for as long as it lasts. Only scrolling by hand
  // snaps; links and buttons that scroll the page glide past sections untouched. With
  // reduced motion the page steps instead of gliding.
  const snapAhead = (from: number, to: number) => {
    const dir = Math.sign(to - from);
    if (!dir) return undefined;
    const zone = innerHeight * 0.85 - (header?.offsetHeight ?? 0);
    // A stop the move crosses, or one it ends within the zone of.
    return stopsNow()
      .filter((s) => (s.y - from) * dir > 2 && (s.y - to) * dir <= zone)
      .sort((a, b) => (a.y - b.y) * dir)[0];
  };

  // Touch, keys and the scrollbar are judged once the page has moved. The wheel is judged
  // before it moves the page (below): letting the browser start its own smooth scroll and
  // then snapping on top of it makes the two fight, and the page jerks.
  let lastScrollAt = 0;
  function onScroll() {
    const y = scrollY;
    const prev = lastY;
    lastY = y;
    const now = performance.now();
    const since = now - lastScrollAt;
    lastScrollAt = now;
    if (glide || now < lockedUntil || now - lastWheelAt < 250) return;
    if (now - userScrolledAt > 1200) return;
    const hit = snapAhead(prev, y);
    if (hit) snapTo(hit, since < 100 ? (y - prev) / since : 0);
  }

  let lastWheelAt = -Infinity;
  let lastWheel = 0;
  // The image viewer (a modal dialog) scrolls on its own; pinch-zoom is not a scroll.
  const notThePage = (e: Event) => (e as WheelEvent).ctrlKey || document.querySelector('dialog[open]') !== null;
  function onWheel(e: WheelEvent) {
    if (notThePage(e)) return;
    const now = performance.now();
    const gap = now - lastWheelAt;
    const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? innerHeight : 1;
    const delta = e.deltaY * unit;
    const fading = gap < 120 && Math.abs(delta) <= Math.abs(lastWheel) + 1;
    lastWheelAt = now;
    lastWheel = delta;
    if (glide) return e.preventDefault();
    // The hold: half a second always, then a trackpad's fading momentum too (a fresh
    // flick — after a pause or harder than the last event — gets through).
    const held = now - landedAt;
    if (held < 450 || (held < 3000 && fading && lockedUntil > landedAt)) return e.preventDefault();
    lockedUntil = 0;
    userScrolledAt = now;
    const end = document.documentElement.scrollHeight - innerHeight;
    const hit = snapAhead(scrollY, Math.max(0, Math.min(end, scrollY + delta)));
    if (hit) {
      e.preventDefault();
      // A wheel notch moves the page over about a tenth of a second; trackpad events
      // come every frame and each carries that frame's move.
      snapTo(hit, delta / Math.min(120, Math.max(16, gap)));
    }
  }

  const locked = () => glide !== 0 || performance.now() < lockedUntil;
  const swallow = (e: Event) => {
    if (!locked() || notThePage(e)) return false;
    e.preventDefault();
    // Momentum keeps the hold going a little, but never past 1.2s after landing.
    if (!glide) lockedUntil = Math.min(Math.max(lockedUntil, performance.now() + 150), landedAt + 1200);
    return true;
  };
  const scrollKeys = new Set(['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', ' ', 'Home', 'End']);

  if (scenes.length) {
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('wheel', onWheel, { passive: false });
    window.addEventListener('touchstart', (e) => {
      touchY = e.touches[0]?.clientY ?? 0;
    }, { passive: true });
    window.addEventListener('touchmove', (e) => {
      // Only a real drag counts as scrolling by hand, not a tap.
      if (!swallow(e) && Math.abs((e.touches[0]?.clientY ?? 0) - touchY) > 8) userScrolledAt = performance.now();
    }, { passive: false });
    window.addEventListener('keydown', (e) => {
      if (!scrollKeys.has(e.key) || (e.target as HTMLElement).closest('input, textarea, button, [contenteditable]')) return;
      if (!swallow(e)) userScrolledAt = performance.now();
    });
  }
</script>

<style>
  /* The hero always fills the screen under the sticky header (its height + 1px border):
     svh, not vh, so mobile browser bars never cut the bottom off. It sits in the site
     container like the header and the sections below, with the gutter above and below it
     too. The status sits at the top, the buttons at the bottom with the title just above
     them; the gap is the least room between the three when content is taller than the screen. */
  .hero {
    min-height: calc(100svh - var(--header-h) - 1px);
    padding: var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  /* The title drops to the buttons, leaving the free space above it. */
  .hero__main {
    margin-top: auto;
    margin-bottom: calc(clamp(32px, 3.5vw, 44px) - 24px);
  }
  /* The title grows with the screen width from 72px on phones up to 156px, one and a half
     times the site's hero size, which it reaches at 1440 as the container stops growing
     (10.8vw). The screen height
     caps it: what is left of the hero after the gutters and about 160px for the status,
     buttons and gaps, shared by three lines at 0.95 — so even a title broken into three
     lines fits. Set a little tighter. */
  .hero__title {
    font-size: min(
      max(4.5rem, 10.8vw),
      9.75rem,
      calc((100svh - var(--header-h) - 1px - 2 * var(--gutter) - 160px) / 2.85)
    );
    line-height: 0.95;
    isolation: isolate; /* keeps the red bar under "obvious" above the page background */
  }
  /* "obvious" is a bar-right like the section headings, tuned for the hero: a heavier word
     and a bar fitted to the tighter line. */
  .hero__accent {
    position: relative;
    display: inline-block;
    padding: 0 0.12em;
    margin: 0 -0.12em;
    /* The title isolates instead: the glint paints the letters as this span's background,
       which the bar would cover if the span were its own stacking context. */
    isolation: auto;
    color: var(--on-accent);
    /* Same face as the rest of the title, just heavier. */
    font-family: inherit;
    font-size: inherit;
    font-style: normal;
    font-weight: 700;
    letter-spacing: inherit;
  }
  .hero__accent::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0.04em;
    bottom: -0.02em;
    left: 0.08em; /* the padding less a hair, so the bar starts at the word, not in the space */
    right: -100vw;
    background: var(--accent);
  }
  .hero__work {
    text-transform: uppercase;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* "complex" stays one word on one line while its letters move. */
  .mess {
    white-space: nowrap;
  }
  .mess > span {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Letters move one after another with a slight overshoot. Weight is animated too
       (Geist is variable), so the word changes in thickness as well as in line. */
    .mess > span {
      transition:
        transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.15),
        font-weight 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.15);
      transition-delay: calc(var(--i) * 25ms);
    }
    /* Hovering "complex" throws its letters out of line; leaving lets them settle again.
       The script below does the same once, on its own, shortly after the page opens. */
    .mess.is-messy > span {
      transform: translateY(var(--y)) rotate(var(--r));
      font-weight: var(--w);
    }
    @media (hover: hover) {
      .mess:hover > span {
        transform: translateY(var(--y)) rotate(var(--r));
        font-weight: var(--w);
      }
    }
  }
  /* Hovering "obvious" sends a glint across the word, once per hover: the red is painted as
     a background clipped to the letters, with a light band that slides from right to left.
     The padding above keeps the paint from being cut at the letters' edges. */
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      .hero__accent {
        background: linear-gradient(
            105deg,
            var(--on-accent) 42%,
            color-mix(in srgb, var(--accent) 25%, #ffffff) 50%,
            var(--on-accent) 58%
          )
          100% 0 / 300% 100% no-repeat;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      /* Set by the script below on pointer enter and cleared when the glint ends, so it
         always plays to the end even if the pointer leaves halfway. */
      .hero__accent.is-glinting {
        animation: glint 1.8s cubic-bezier(0.45, 0, 0.2, 1);
      }
    }
  }
  @keyframes glint {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }
  .hero__status {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    line-height: 1.5;
  }
  .dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    margin-top: 0.45em;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 50%, transparent);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    to {
      box-shadow: 0 0 0 10px transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  /* One outline pill cut in two: download the file or open it in a new tab. Each half
     has its own border so it can lift on its own; the second overlaps the first by 1px,
     so the seam stays a single line. */
  .btn-split {
    display: inline-flex;
  }
  .btn-split__part {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    padding: 0 22px;
    border: 1px solid var(--ink);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    transition:
      transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }
  .btn-split__part:first-child {
    flex: 1;
    padding-left: 28px;
    border-radius: 999px 0 0 999px;
  }
  .btn-split__part + .btn-split__part {
    margin-left: -1px;
    padding-right: 26px;
    border-radius: 0 999px 999px 0;
  }
  .btn-split__part:hover,
  .btn-split__part:focus-visible {
    z-index: 1;
  }
  .btn-split__part:hover {
    background: var(--surface);
  }
  .btn-split__part:active {
    transform: scale(0.98);
  }
  /* Who I am, in a sentence and three numbers: the first section below the hero. */
  .intro {
    padding-top: clamp(64px, 9vw, 120px);
    padding-bottom: clamp(64px, 8vw, 96px);
  }
  .intro__text {
    max-width: 24em;
    font-size: var(--step-h3);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  /* The role picks up the hero's red. accent-ink: on light paper the text can drop below
     24px, where the plain brand red is too faint. */
  .intro__role {
    color: var(--accent-ink);
  }
  .facts {
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 24px;
  }
  .facts li {
    border-top: 1px solid var(--rule);
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .facts__value {
    font-size: clamp(1.625rem, 1.2rem + 1.2vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .facts__label {
    font-size: 15px;
    color: var(--muted);
  }

  /* The hero and the sections after it move as scenes (the hero is already in place when
     the page opens, so it only leaves). Each one rises out of a light blur a little faster
     than the page scrolls and is sharp by the time its top is a third of the way up the
