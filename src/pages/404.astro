---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found" compactFooter>
  <section class="container nf">
    <p class="eyebrow">404</p>
    <h1 class="h-hero">This page took a <span class="accent-word">different route.</span></h1>
    <p class="lead">The link may be old — the portfolio moved from Framer. Everything is still here.</p>
    <div class="nf__ctas">
      <a href={url('/#work')} class="btn btn--accent">See the work</a>
      <a href={url('/')} class="btn btn--outline">Home</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    padding-top: clamp(64px, 12vw, 160px);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .nf__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
